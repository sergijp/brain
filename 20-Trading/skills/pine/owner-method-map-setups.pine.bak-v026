//@version=5
// Owner Method — Map + Setups  (v0.26, 09.10.2026)
// Карта ліквідності і зон + детектор сетапу «зняття пулу → імпульсний реклейм» + супровід угод + історія останніх угод.
// Працювати на M5. Стан змінюється лише на закритих барах (без перемальовування).
indicator("тестовий мій", shorttitle="тестовий мій", overlay=true, max_lines_count=500, max_boxes_count=500, max_labels_count=500)

// ═════════════ 1 · БІАС І ТОРГОВИЙ ЧАС ═════════════
g1 = "1 · Біас і торговий час"
biasIn   = input.string("Тренд D (3 дні)", "Напрям торгівлі (біас дня)", options=["Тренд D (3 дні)", "Азія + тренд D", "Авто (за азією)", "Лише шорт", "Лише лонг", "Обидва боки"], group=g1, tooltip="Тренд D: торгуємо за напрямом денного тренду (закриття вчора проти закриття 4 дні тому). Азія + тренд D: обидва сигнали мають збігатися. Авто (за азією): екстремум азії на рівні карти + достатній діапазон. За бектестом 08–10.2026 (EURUSD, GBPUSD, GER40) найкращий результат давав «Тренд D», а «Авто (за азією)» — найгірший.")
kzMode   = input.string("Лондон + Нью-Йорк", "Вікна входу (killzone)", options=["Лондон + Нью-Йорк", "Весь торговий час"], group=g1, tooltip="Нові входи лише у вікнах активності ліквідності. Вихід по часу і супровід працюють завжди.")
kz1a     = input.float(7.0, "Лондон: з (година UTC)", step=0.5, group=g1, inline="k1")
kz1b     = input.float(10.0, "до", step=0.5, group=g1, inline="k1")
kz2a     = input.float(12.5, "Нью-Йорк: з (година UTC)", step=0.5, group=g1, inline="k2")
kz2b     = input.float(16.0, "до", step=0.5, group=g1, inline="k2")
sessFromH = input.int(5, "Початок торгів — година UTC", minval=0, maxval=23, group=g1, inline="a")
sessFromM = input.int(50, "хвилина", minval=0, maxval=59, group=g1, inline="a")
sessToH   = input.int(19, "Кінець торгів / примусове закриття — година UTC", minval=0, maxval=23, group=g1, inline="b")
sessToM   = input.int(0, "хвилина", minval=0, maxval=59, group=g1, inline="b")
dayLimit  = input.float(-3.0, "Денна межа збитку, R (після неї нових угод немає)", group=g1)
wkLimit   = input.float(-6.0, "Тижнева межа збитку, R", group=g1)
friCut    = input.float(16.0, "П'ятниця: нових входів не після (година UTC)", step=0.5, minval=0.0, maxval=24.0, group=g1)
chainOn   = input.bool(false, "Ланцюг після цілі: зворотна угода ≤40 хв (правило #40/#58)", group=g1, tooltip="Після досягнення цілі рівень працює в інший бік: протягом 8 барів M5 дозволено сетап у зворотний бік навіть проти біасу. За бектестом 08–10.2026 різниці майже немає (на 2 угоди більше, середній результат трохи нижчий), тому вимкнено за замовчуванням.")

// ═════════════ 2 · УМОВИ ВХОДУ ═════════════
g2 = "2 · Умови входу (зняття пулу + реклейм)"
sweepIn  = input.float(2.0, "Мін. прокол рівня для зняття, пунктів", step=0.5, minval=0.0, group=g2, tooltip="Правило #25: прокол 2–3 п з поверненням = зняття. За бектестом 08–10.2026 мінімальний прокол 2–3 п дав кращий результат, ніж 0.3 п (+0.67…+0.72R проти +0.47R), далі від 4 п результат падає. Для індексів — пункти.")
maxAge   = input.int(3, "Скільки барів після зняття чекати реклейм", minval=0, group=g2)
minBody  = input.float(0.3, "Мін. тіло реклейм-бару, ×ATR", step=0.05, group=g2)
entryFx  = input.float(15.0, "Макс. відстань входу від екстремуму зняття, пунктів (форекс)", step=1.0, group=g2)
entryAtr = input.float(2.7, "Макс. відстань входу від екстремуму зняття, ×ATR (індекси)", step=0.1, group=g2)
atrLen   = input.int(24, "Довжина ATR (барів M5)", minval=2, group=g2)
entryMode = input.string("Лімітка на відкритті реклейм-бару", "Тип входу", options=["Лімітка на відкритті реклейм-бару", "Лімітка на Open OB (свічка перед імпульсом)", "Ринком на закритті"], group=g2, tooltip="Лімітка: чекаємо ретест відкриття реклейм-бару (вхід кращий, але угода не завжди заповнюється). Ринком: вхід одразу на закритті реклейм-бару. За бектестом лімітка давала приблизно +0.15…0.2R на угоду більше, ніж ринок.")
fvgOn    = input.bool(true, "FVG-ліміт ноги зняття (M15): ліміт на краю FVG після зняття", group=g2, tooltip="Після зняття максимуму/мінімуму ціна рухається імпульсом і лишає FVG на M15. Ліміт ставиться на ближній край цього FVG, стоп за екстремумом зняття, ціль найближчий пул з RR від мінімуму. Це сетап власника (07:15 UTC 09.10: шорт 1.12323, SL 1.12428). За бектестом 08–10.2026 він додає угоди зі слабким результатом, тож це опція, а не обіцянка прибутку.")
fvgBase  = input.bool(true, "FVG-ліміт: дозволено ставити з початку сесії (до вікна входу); заповнення лише у вікні", group=g2, tooltip="Ранковий FVG з'являється ще до 07:00 UTC, а ліміт на нього заповнюється пізніше. Вимкнено: ліміт можна ставити лише всередині вікон входу. За бектестом 08–10.2026 дозвіл ставити раніше додає угоди зі слабким результатом.")
fvgMin   = input.float(1.5, "FVG-ліміт: мін. розмір FVG, пунктів", step=0.5, group=g2)
fvgBuf   = input.float(1.0, "FVG-ліміт: буфер стопа за екстремумом, пунктів", step=0.5, group=g2)
fvgRiskAtr = input.float(8.0, "FVG-ліміт: макс. ризик, ×ATR(M5)", step=0.5, group=g2)
fvgExp   = input.int(96, "FVG-ліміт: скільки барів M5 чекати заповнення (96 = 8 годин)", minval=6, group=g2)
pendBars = input.int(6, "Скільки барів чекати заповнення лімітки", minval=1, group=g2)

// ═════════════ 3 · СТОП, РИЗИК І ЦІЛЬ ═════════════
g3 = "3 · Стоп, ризик і ціль"
bufMult  = input.float(1.0, "Буфер стопа за екстремумом зняття, ×ATR", step=0.05, group=g3)
minStopP = input.float(2.0, "Мін. відстань стопа, пунктів (форекс)", step=0.5, group=g3)
riskMinA = input.float(0.8, "Мін. ризик угоди, ×ATR", step=0.1, group=g3)
riskMaxA = input.float(3.0, "Макс. ризик угоди, ×ATR", step=0.1, group=g3)
rrMin    = input.float(2.25, "Мін. співвідношення ризик/прибуток (RR)", step=0.05, group=g3)

// ═════════════ 4 · ЩО МАЛЮВАТИ ═════════════
g4 = "4 · Що малювати на графіку"
showLvls = input.bool(true, "Рівні ліквідності (PDH/PDL, азія, свінги…)", group=g4)
showFvg  = input.bool(true, "FVG — гепи справедливої вартості", group=g4)
showOb   = input.bool(true, "OB — ордер-блоки", group=g4)
showH1   = input.bool(true, "Таймфрейм H1", group=g4, inline="t")
showH4   = input.bool(true, "H4", group=g4, inline="t")
showD    = input.bool(true, "D (денний)", group=g4, inline="t")
showSessLines = input.bool(true, "Лінії PDC і Daily Open", group=g4)
dailyMode = input.string("Свічка D (17:00 Нью-Йорк)", "Daily Open — звідки брати", options=["Свічка D (17:00 Нью-Йорк)", "00:00 Нью-Йорк (midnight open)"], group=g4, tooltip="Свічка D: відкриття денної свічки (17:00 Нью-Йорк = 00:00 за Києвом влітку). Друга опція: відкриття о 00:00 Нью-Йорк — це вже New York Open.")
showPD   = input.bool(true, "Prev Day High / Low (PDH, PDL)", group=g4)
showWeek = input.bool(true, "Weekly Open, Prev Week High / Low (PWH, PWL)", group=g4)
showNyO  = input.bool(true, "New York Open", group=g4, inline="ny")
nyH      = input.float(0.0, "час за Нью-Йорком (0 = 00:00 = 07:00 за Києвом влітку, 08:00 взимку з поправкою)", step=0.5, group=g4, inline="ny")
showPW   = input.bool(true, "PWH / PWL як пули ліквідності (цілі й стопи, правило #49)", group=g4)
showDead = input.bool(false, "Показувати зняті рівні та зламані зони (сірі, зі словами «знято», INV, MIT)", group=g4, tooltip="Вимкнено: щойно рівень знято, його лінія й підпис зникають; зламана FVG чи OB зникає. Знятий рівень усе одно враховується в логіці сетапу.")
showPool = input.bool(true, "Виділяти пули ліквідності (рівні свінги EQH / EQL, ×2 і більше)", group=g4, tooltip="Пул ліквідності — кілька однакових максимумів (BSL, стопи покупців зверху) чи мінімумів (SSL, стопи продавців знизу) на одній ціні. Такі рівні малюються товстою лінією і плашкою «ПУЛ»; зняття пулу — основа сетапу.")
showNear = input.bool(true, "Найближчі підтримка й опір (завжди виділені)", group=g4)
maxLv    = input.int(70, "Макс. рівнів на графіку", minval=10, maxval=200, group=g4)
maxZn    = input.int(150, "Макс. зон на графіку", minval=10, maxval=200, group=g4)
zoneBand = input.float(4.0, "Малювати зони лише в межах ×ATR(D) від ціни", step=0.5, group=g4)
dispMult = input.float(1.5, "OB: сила зсуву (тіло свічки ≥ ×середній діапазон)", step=0.1, group=g4)

// ═════════════ 5 · ВИГЛЯД ═════════════
g5 = "5 · Вигляд і кольори"
colBsl   = input.color(color.new(#ef5350, 0), "Колір: ліквідність зверху (BSL)", group=g5, inline="c1")
colSsl   = input.color(color.new(#26a69a, 0), "знизу (SSL)", group=g5, inline="c1")
colD     = input.color(color.new(#ab47bc, 0), "Колір зон: D", group=g5, inline="c2")
colH4    = input.color(color.new(#ff9800, 0), "H4", group=g5, inline="c2")
colH1    = input.color(color.new(#42a5f5, 0), "H1", group=g5, inline="c2")
colRes   = input.color(color.new(#ff5252, 0), "Колір: найближчий опір", group=g5, inline="c4")
colSup   = input.color(color.new(#00e676, 0), "найближча підтримка", group=g5, inline="c4")
colRisk  = input.color(color.new(#ef5350, 0), "Колір угоди: ризик", group=g5, inline="c3")
colRew   = input.color(color.new(#26a69a, 0), "ціль", group=g5, inline="c3")
colPend  = input.color(color.new(#ff9800, 0), "Колір лімітки (очікує заповнення)", group=g5)
colPDC   = input.color(color.new(#2962ff, 35), "Колір ключових рівнів: PDC", group=g5, inline="k0")
colDO    = input.color(color.new(#2979ff, 5), "Daily Open", group=g5, inline="k0")
colNY    = input.color(color.new(#e040fb, 5), "New York Open", group=g5, inline="k0")
colWO    = input.color(color.new(#ffb300, 5), "Weekly Open", group=g5, inline="k1")
colPDH   = input.color(color.new(#ef5350, 5), "Prev Day High", group=g5, inline="k1")
colPDL   = input.color(color.new(#26a69a, 5), "Prev Day Low", group=g5, inline="k1")
colPWH   = input.color(color.new(#ff7043, 5), "Prev Week High", group=g5, inline="k2")
colPWL   = input.color(color.new(#26c6da, 5), "Prev Week Low", group=g5, inline="k2")
zoneTr   = input.int(86, "Прозорість зон, % (більше = прозоріше)", minval=50, maxval=98, group=g5)
boxTr    = input.int(80, "Прозорість боксів угоди, %", minval=50, maxval=98, group=g5)
lblSizeIn = input.string("Малий", "Розмір підписів", options=["Дрібний", "Малий", "Звичайний"], group=g5)
keySizeIn = input.string("Звичайний", "Розмір підписів ключових рівнів (Daily/Weekly/NY Open…)", options=["Малий", "Звичайний", "Великий"], group=g5)
showTable = input.bool(true, "Таблиця стану (вгорі справа)", group=g5)

// ═════════════ 6 · ІСТОРІЯ УГОД ═════════════
g6 = "6 · Історія угод"
showTrades = input.bool(true, "Малювати позиції (бокси, лінії, мітки)", group=g6, tooltip="Вимкнено: позиції лише рахуються (таблиця, статистика), але на графіку не малюються.")
histN    = input.int(5, "Скільки останніх угод показувати на графіку", minval=1, maxval=50, group=g6, tooltip="Старіші угоди видаляються з графіка. Активна угода завжди показується.")

// ═════════════ 7 · РАХУНОК І РОЗМІР ПОЗИЦІЇ ═════════════
g8 = "7 · Рахунок і розмір позиції"
showLot  = input.bool(true, "Показувати обсяг (лоти) на позиції", group=g8)
lotSizeIn = input.string("Великий", "Розмір плашки з лотами", options=["Звичайний", "Великий", "Величезний"], group=g8)
accSize  = input.float(10000.0, "Розмір рахунку, $", minval=0.0, step=100.0, group=g8)
riskPct  = input.float(1.0, "Ризик на угоду, % від рахунку", minval=0.0, step=0.1, group=g8)
riskUsdIn = input.float(0.0, "…або фіксований ризик на угоду, $ (0 = рахувати за %)", minval=0.0, step=10.0, group=g8)
fxPipVal = input.float(10.0, "Форекс: вартість 1 пункту (0.0001) за 1 лот, $", minval=0.0, step=0.5, group=g8, tooltip="EURUSD, GBPUSD та інші пари з USD в котируванні: 10$. Для JPY, CHF, CAD пар вкажи свою.")
idxPtVal = input.float(1.0, "Індекси: вартість 1 пункту за 1 лот, $", minval=0.0, step=0.1, group=g8, tooltip="GER40 у брокера: перевір специфікацію контракту (зазвичай 1 пункт = 1 одиниця валюти рахунку на 1 лот).")
lotStep  = input.float(0.01, "Крок лоту (мінімальний обсяг)", minval=0.0001, step=0.01, group=g8)

// ═════════════ 8 · СТРУКТУРА РИНКУ (поточний таймфрейм) ═════════════
g9 = "8 · Структура ринку (поточний ТФ)"
showStruct = input.bool(true, "BOS і Shift (злам структури / зсув)", group=g9, tooltip="BOS — злам останнього свінгу за напрямом тренду (продовження). Shift — злам свінгу проти тренду (зміна характеру, CHoCH/MSS). Працює на тому таймфреймі, який відкритий на графіку.")
showRange = input.bool(true, "Позначати боковик / акумуляцію (діапазон)", group=g9)
showAmd  = input.bool(true, "AMD: Accumulation (Азія) → Manipulation → Distribution", group=g9, tooltip="A — діапазон азійської сесії (22:00–06:00 UTC), коли ринок накопичує. M — зняття максимуму або мінімуму Азії у вікні 06:00–14:00 UTC (маніпуляція, Judas swing). D — закриття за протилежним краєм Азії: розподіл, рух у бік, протилежний до зняття.")
amNetMax = input.float(0.5, "Акумуляція Азії: макс. чистий рух за сесію, частка діапазону", step=0.1, minval=0.1, maxval=1.0, group=g9, tooltip="Якщо Азія пройшла тренд (закриття далеко від відкриття, більше цієї частки діапазону), це не акумуляція, і бокс A не малюється.")
colAcc   = input.color(color.new(#4dd0e1, 0), "Колір акумуляції (A)", group=g9, inline="a1")
colMan   = input.color(color.new(#ffa726, 0), "маніпуляції (M)", group=g9, inline="a1")
colDis   = input.color(color.new(#66bb6a, 0), "розподілу (D)", group=g9, inline="a1")
showShiftLvl = input.bool(true, "Показувати, де буде найближчий Shift і BOS (рівні-тригери)", group=g9, tooltip="Shift ▲/▼ — рівень, за який ціні треба закритися, щоб структура змінила напрям. BOS — рівень продовження тренду. Рівні беруться з останніх свінгів.")
swLen    = input.int(5, "Довжина свінгу (барів з кожного боку)", minval=2, maxval=20, group=g9)
maxMarks = input.int(20, "Скільки останніх міток BOS/Shift тримати на графіку", minval=5, maxval=100, group=g9)
rngLen   = input.int(36, "Боковик: вікно пошуку, барів", minval=10, maxval=200, group=g9)
rngMaxAtr = input.float(4.0, "Боковик: макс. висота діапазону, ×ATR", step=0.5, group=g9)
adxMax   = input.float(22.0, "Боковик: ADX нижче за", step=1.0, group=g9)
colBos   = input.color(color.new(#26a69a, 0), "Колір BOS", group=g9, inline="s1")
colShift = input.color(color.new(#ffb300, 0), "Shift", group=g9, inline="s1")
colRng   = input.color(color.new(#b0bec5, 0), "Боковик", group=g9, inline="s1")

// ═════════════ 9 · АЛЕРТИ ═════════════
g7 = "9 · Алерти"
tgChat   = input.string("", "Telegram chat_id (порожньо = звичайний текст)", group=g7)

// ───────────── Інструмент і масштаб
isFx    = syminfo.type == "forex"
isJpy   = str.contains(syminfo.ticker, "JPY")
pip     = isFx ? (isJpy ? 0.01 : 0.0001) : 1.0
unitTxt = isFx ? " п" : " пт"
sweepMin = sweepIn * pip
zoneTol  = (isFx ? 0.3 : 1.0) * pip
clusTol  = (isFx ? 1.0 : 3.0) * pip
minStop  = isFx ? minStopP * pip : 0.0
fvgScl   = isFx ? 1.0 : 3.0
atrV     = ta.atr(atrLen)
atrD     = request.security(syminfo.tickerid, "D", ta.atr(14)[1], lookahead = barmerge.lookahead_on)
[pdHD, pdLD] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_on)
[wkO, pwH, pwL] = request.security(syminfo.tickerid, "W", [open, high[1], low[1]], lookahead = barmerge.lookahead_on)
[dcl1, dcl4] = request.security(syminfo.tickerid, "D", [close[1], close[4]], lookahead = barmerge.lookahead_on)
htfTr    = dcl1 > dcl4 ? 1 : dcl1 < dcl4 ? -1 : 0

sessFrom = sessFromH * 60 + sessFromM
sessTo   = sessToH * 60 + sessToM
minOfDay = hour(time, "UTC") * 60 + minute(time, "UTC")
newDay   = dayofweek(time, "UTC") != dayofweek(time[1], "UTC")
newWeek  = weekofyear(time, "UTC") != weekofyear(time[1], "UTC")
inSess   = minOfDay >= sessFrom and minOfDay < sessTo
kzOk     = kzMode == "Весь торговий час" or (minOfDay >= kz1a * 60 and minOfDay < kz1b * 60) or (minOfDay >= kz2a * 60 and minOfDay < kz2b * 60)
tradeWin = inSess and kzOk
lblSize  = lblSizeIn == "Дрібний" ? size.tiny : lblSizeIn == "Звичайний" ? size.normal : size.small
lotSz = lotSizeIn == "Звичайний" ? size.normal : lotSizeIn == "Великий" ? size.large : size.huge

// ───────────── Типи
type Lvl
    float  p
    float  lo
    float  hi
    bool   isHigh
    int    n
    bool   swept
    bool   done
    int    born
    int    sweepBar
    float  ext
    string tag
    line   ln
    label  lb

type Zn
    box    bx
    bool   bull
    bool   isFvg
    bool   dead
    float  top
    float  bot
    string tf

type Trd
    box    rb
    box    wb
    line   el
    label  lb
    label  xl
    int    side
    float  entry
    float  sl
    float  tp
    float  r
    bool   open
    bool   sh
    bool   late
    int    xbar
    label  tl
    label  lotl
    line   tln

var array<Lvl> lv = array.new<Lvl>()
var array<Zn>  zn = array.new<Zn>()
var array<Trd> trades = array.new<Trd>()

// ───────────── Рівні
lblText(Lvl l) =>
    (l.isHigh ? "▲ BSL " : "▼ SSL ") + (l.n > 1 and showPool ? "ПУЛ " : "") + l.tag + (l.n > 1 ? " ×" + str.tostring(l.n) : "") + "  " + str.tostring(l.p, format.mintick)

dropLvl(int i) =>
    Lvl o = lv.get(i)
    line.delete(o.ln)
    label.delete(o.lb)
    lv.remove(i)

addLevel(float price, bool isHigh, string tag) =>
    bool merged = false
    int sz = lv.size()
    if sz > 0
        for i = 0 to sz - 1
            Lvl l = lv.get(i)
            if not l.swept and l.isHigh == isHigh and math.abs(l.p - price) <= clusTol
                l.n += 1
                l.lo := math.min(l.lo, price)
                l.hi := math.max(l.hi, price)
                l.p := (l.lo + l.hi) / 2
                line.set_y1(l.ln, l.p)
                line.set_y2(l.ln, l.p)
                label.set_y(l.lb, l.p)
                label.set_text(l.lb, lblText(l))
                if showPool and l.n >= 2
                    color pc = isHigh ? colBsl : colSsl
                    line.set_width(l.ln, 3)
                    line.set_color(l.ln, color.new(pc, 0))
                    line.set_style(l.ln, line.style_solid)
                    label.set_style(l.lb, label.style_label_left)
                    label.set_color(l.lb, color.new(pc, 15))
                    label.set_textcolor(l.lb, isHigh ? color.white : color.black)
                merged := true
                break
    if not merged
        color c = isHigh ? colBsl : colSsl
        bool sessTag = tag == "PDH" or tag == "PDL" or tag == "ASIA H" or tag == "ASIA L" or tag == "DAY"
        line ln = line.new(bar_index, price, bar_index + 1, price, extend = extend.right, color = color.new(c, 25), style = sessTag ? line.style_dotted : line.style_dashed, width = tag == "D" ? 2 : 1)
        Lvl nl = Lvl.new(price, price, price, isHigh, 1, false, false, bar_index, na, na, tag, ln, na)
        nl.lb := label.new(bar_index, price, lblText(nl), style = label.style_none, textcolor = color.new(c, 10), size = lblSize)
        lv.push(nl)
        if lv.size() > maxLv
            dropLvl(0)

// ───────────── Стан дня / азії
var float dayH = na
var float dayL = na
var float dayO = na
var float pdh  = na
var float pdl  = na
var float pdc  = na
var float ldnO = na
var float nyO  = na
var float dOpenNY = na
var float asCurH = na
var float asCurL = na
var int   asCurHt = na
var int   asCurLt = na
var float asH = na
var float asL = na
var int   asHt = na
var int   asLt = na
var int   biasAuto = 0
var float dayR = 0.0
var float wkR = 0.0
var float wkHi = na
var float wkLo = na
var int   chainUntil = -1
var int   chainSide = 0
var float lastR = na

inAsia  = hour(time, "UTC") >= 22 or hour(time, "UTC") < 6
asStart = inAsia and not inAsia[1]
asEnd   = (not inAsia) and inAsia[1]

// ───────────── Дані старших ТФ (без перемальовування: закрита свічка HTF)
htf(simple string tf) =>
    request.security(syminfo.tickerid, tf, [time[1], time[3], time[4], time[5], open[1], high[1], low[1], close[1], open[2], high[2], low[2], close[2], open[3], high[3], low[3], close[3], open[4], high[4], low[4], close[4], open[5], high[5], low[5], close[5], ta.sma(high - low, 60)[1]], lookahead = barmerge.lookahead_on)

[tH1, tH1a, tH1b, tH1c, oH1_1, hH1_1, lH1_1, cH1_1, oH1_2, hH1_2, lH1_2, cH1_2, oH1_3, hH1_3, lH1_3, cH1_3, oH1_4, hH1_4, lH1_4, cH1_4, oH1_5, hH1_5, lH1_5, cH1_5, avH1] = htf("60")
[tH4, tH4a, tH4b, tH4c, oH4_1, hH4_1, lH4_1, cH4_1, oH4_2, hH4_2, lH4_2, cH4_2, oH4_3, hH4_3, lH4_3, cH4_3, oH4_4, hH4_4, lH4_4, cH4_4, oH4_5, hH4_5, lH4_5, cH4_5, avH4] = htf("240")
[tD1, tD1a, tD1b, tD1c, oD_1, hD_1, lD_1, cD_1, oD_2, hD_2, lD_2, cD_2, oD_3, hD_3, lD_3, cD_3, oD_4, hD_4, lD_4, cD_4, oD_5, hD_5, lD_5, cD_5, avD] = htf("D")

[phH1, plH1, ptH1] = request.security(syminfo.tickerid, "60", [ta.pivothigh(high, 2, 2)[1], ta.pivotlow(low, 2, 2)[1], time[3]], lookahead = barmerge.lookahead_on)
[phD, plD, ptD]    = request.security(syminfo.tickerid, "D", [ta.pivothigh(high, 2, 2)[1], ta.pivotlow(low, 2, 2)[1], time[3]], lookahead = barmerge.lookahead_on)

// ───────────── Зони (FVG + OB)
newZone(string tf, bool bull, bool isFvg, int tLeft, float bot, float top) =>
    color c = tf == "D" ? colD : tf == "H4" ? colH4 : colH1
    color fillC = isFvg ? color.new(c, zoneTr) : color.new(bull ? colSsl : colBsl, zoneTr)
    color brd = isFvg ? color.new(c, 55) : color.new(bull ? colSsl : colBsl, 55)
    box bx = box.new(tLeft, top, time, bot, xloc = xloc.bar_time, extend = extend.right, border_color = brd, border_width = 1, bgcolor = fillC, text = tf + (isFvg ? " FVG " : " OB ") + (bull ? "▲" : "▼"), text_color = color.new(c, 15), text_size = lblSize, text_halign = text.align_right)
    zn.push(Zn.new(bx, bull, isFvg, false, top, bot, tf))
    if zn.size() > maxZn
        Zn o = zn.get(0)
        box.delete(o.bx)
        zn.remove(0)

procHtf(string tf, bool on, float minFvg, int t1, int t1prev, int t3, int t4, int t5, float o1, float h1, float l1, float c1, float o2, float h2, float l2, float c2, float o3, float h3, float l3, float c3, float o4, float h4, float l4, float c4, float o5, float h5, float l5, float c5, float av) =>
    if on and not na(t1) and t1 != t1prev and not na(atrD)
        bool inBand = math.abs(close - (h2 + l2) / 2) <= zoneBand * atrD
        if showFvg and inBand
            if l1 > h3 and (l1 - h3) >= minFvg
                newZone(tf, true, true, t3, h3, l1)
            if h1 < l3 and (l3 - h1) >= minFvg
                newZone(tf, false, true, t3, h1, l3)
        if showOb and inBand and av > 0
            float body2 = math.abs(c2 - o2)
            if body2 >= dispMult * av
                if c2 > o2 and l1 > h3
                    if o3 > c3
                        newZone(tf, true, false, t3, l3, h3)
                    else if o4 > c4
                        newZone(tf, true, false, t4, l4, h4)
                    else if o5 > c5
                        newZone(tf, true, false, t5, l5, h5)
                if c2 < o2 and h1 < l3
                    if o3 < c3
                        newZone(tf, false, false, t3, l3, h3)
                    else if o4 < c4
                        newZone(tf, false, false, t4, l4, h4)
                    else if o5 < c5
                        newZone(tf, false, false, t5, l5, h5)

updateZones() =>
    int sz = zn.size()
    if sz > 0
        for i = 0 to sz - 1
            Zn z = zn.get(i)
            if not z.dead
                if z.bull
                    if close < z.bot - zoneTol
                        z.dead := true
                    else if z.isFvg and low < z.top
                        z.top := math.max(low, z.bot)
                        box.set_top(z.bx, z.top)
                else
                    if close > z.top + zoneTol
                        z.dead := true
                    else if z.isFvg and high > z.bot
                        z.bot := math.min(high, z.top)
                        box.set_bottom(z.bx, z.bot)
                if z.dead
                    if showDead
                        box.set_bgcolor(z.bx, color.new(color.gray, 93))
                        box.set_border_color(z.bx, color.new(color.gray, 75))
                        box.set_text(z.bx, (z.isFvg ? "INV " : "MIT ") + z.tf + (z.isFvg ? " FVG" : " OB"))
                        box.set_text_color(z.bx, color.new(color.gray, 30))
                        box.set_extend(z.bx, extend.none)
                        box.set_right(z.bx, time)
                    else
                        box.delete(z.bx)

// ───────────── Стан поточної угоди
var bool   tOn    = false
var int    tSide  = 0
var float  tEntry = na
var float  tSl    = na
var float  tTp    = na
var int    tBar   = na
var int    tNSig  = 0
var bool   pFvg   = false
var float  pInval = na
var int    swHBar = na
var float  swHMax = na
var int    swLBar = na
var float  swLMin = na
var float  cO = na
var float  cH = na
var float  cL = na
var float  cC = na
var float  o1 = na
var float  h1 = na
var float  l1 = na
var float  c1 = na
var float  o2 = na
var float  h2 = na
var float  l2 = na
var float  c2 = na
var bool   pOn    = false
var int    pBar   = na
var int    pExp   = na
var int    pSide  = 0
var float  pEntry = na
var float  pSl    = na
var float  pTp    = na
var int    curBias = 0
var float  tLot   = na
var float  tRiskUsd = na

fmt(float v) => str.tostring(v, format.mintick)
vis(color c) => showTrades ? c : color.new(c, 100)
sgn(float v) => (v >= 0 ? "+" : "") + str.tostring(v, "0.00")

sendAlert(string txt) =>
    string m = tgChat == "" ? txt : '{"chat_id":"' + tgChat + '","parse_mode":"HTML","text":"' + txt + '"}'
    alert(m, alert.freq_once_per_bar_close)

trimTrades() =>
    while trades.size() > histN
        Trd o = trades.get(0)
        box.delete(o.rb)
        box.delete(o.wb)
        line.delete(o.el)
        label.delete(o.lb)
        if not na(o.xl)
            label.delete(o.xl)
        if not na(o.tl)
            label.delete(o.tl)
        if not na(o.lotl)
            label.delete(o.lotl)
        if not na(o.tln)
            line.delete(o.tln)
        trades.remove(0)

// ═════════════ ОСНОВНА ЛОГІКА (лише закриті бари) ═════════════
if barstate.isconfirmed
    // --- зміна дня
    if newWeek or na(wkHi)
        if not na(wkHi) and showPW
            addLevel(wkHi, true, "PWH")
            addLevel(wkLo, false, "PWL")
        wkHi := high
        wkLo := low
        wkR := 0.0
    else
        wkHi := math.max(wkHi, high)
        wkLo := math.min(wkLo, low)
    if newDay or na(dayH)
        if not na(dayH)
            pdh := dayH
            pdl := dayL
            pdc := close[1]
            if showLvls
                addLevel(pdh, true, "PDH")
                addLevel(pdl, false, "PDL")
        dayH := high
        dayL := low
        dayO := open
        dayR := 0.0
    // --- азійська сесія
    if asStart
        asCurH := high
        asCurL := low
        asCurHt := time
        asCurLt := time
    else if inAsia
        if high > asCurH
            asCurH := high
            asCurHt := time
        if low < asCurL
            asCurL := low
            asCurLt := time
    if asEnd and not na(asCurH)
        asH := asCurH
        asL := asCurL
        asHt := asCurHt
        asLt := asCurLt
        if showLvls
            addLevel(asH, true, "ASIA H")
            addLevel(asL, false, "ASIA L")
        // авто-біас (#46, спрощено): екстремум азії на рівні карти + діапазон до екстремуму >= порогу
        float minRng = isFx ? 15.0 * pip : 2.5 * atrV
        float tolMap = isFx ? 20.0 * pip : 60.0
        bool hiAtLvl = false
        bool loAtLvl = false
        int sz0 = lv.size()
        if sz0 > 0
            for i = 0 to sz0 - 1
                Lvl l = lv.get(i)
                if l.tag != "ASIA H" and l.tag != "ASIA L"
                    if l.isHigh and math.abs(asH - l.p) <= tolMap
                        hiAtLvl := true
                    if not l.isHigh and math.abs(asL - l.p) <= tolMap
                        loAtLvl := true
        bool hiOk = hiAtLvl and asHt > asLt and (asH - asL) >= minRng
        bool loOk = loAtLvl and asLt > asHt and (asH - asL) >= minRng
        biasAuto := hiOk and not loOk ? -1 : loOk and not hiOk ? 1 : 0
    // --- відкриття Лондона
    if hour(time, "UTC") == 7 and minute(time, "UTC") == 0
        ldnO := open
    int nyMin = hour(time, "America/New_York") * 60 + minute(time, "America/New_York")
    if nyMin == 0
        dOpenNY := open
        nyO := na
    if nyMin == math.round(nyH * 60)
        nyO := open

    // --- свінги H1 / D
    if showLvls
        if showH1 and not na(phH1) and ptH1 != ptH1[1]
            addLevel(phH1, true, "H1")
        if showH1 and not na(plH1) and ptH1 != ptH1[1]
            addLevel(plH1, false, "H1")
        if showD and not na(phD) and ptD != ptD[1]
            addLevel(phD, true, "D")
        if showD and not na(plD) and ptD != ptD[1]
            addLevel(plD, false, "D")

    // --- зняття / реклейм / сетап
    // --- лімітка: заповнення / скасування
    if pOn and not tOn and bar_index > pBar
        Trd pt = trades.last()
        bool tpTouched = pSide == -1 ? low <= pTp : high >= pTp
        bool filled = (pSide == -1 ? high >= pEntry : low <= pEntry) and (not pFvg or tradeWin)
        if filled and not tpTouched
            tOn := true
            tSide := pSide
            tEntry := pEntry
            tSl := pSl
            tTp := pTp
            tBar := bar_index - 1
            pOn := false
            pFvg := false
            box.set_border_style(pt.rb, line.style_solid)
            box.set_border_style(pt.wb, line.style_solid)
            label.set_text(pt.lb, str.replace(label.get_text(pt.lb), "◔ ЛІМІТКА · чекає\n", "✔ ЗАПОВНЕНО · "))
            label.set_color(pt.lb, vis(color.new(#2962ff, 5)))
            label.set_textcolor(pt.lb, vis(color.white))
            line.set_color(pt.el, vis(color.new(color.white, 20)))
            line.set_style(pt.el, line.style_solid)
            line.set_extend(pt.el, extend.none)
            sendAlert("🟢 " + syminfo.ticker + (pSide == -1 ? " ШОРТ " : " ЛОНГ ") + fmt(pEntry) + " | SL " + fmt(pSl) + " | TP " + fmt(pTp) + " | RR " + str.tostring(math.abs(pTp - pEntry) / math.abs(pEntry - pSl), "0.00") + " | " + str.tostring(tLot, "0.00") + " лот ($" + str.tostring(tRiskUsd, "0") + ")")
        else if tpTouched or bar_index >= pExp or (pFvg ? (not inSess or (pSide == -1 ? close > pInval : close < pInval)) : not tradeWin)
            pFvg := false
            box.delete(pt.rb)
            box.delete(pt.wb)
            line.delete(pt.el)
            label.delete(pt.lb)
            if not na(pt.lotl)
                label.delete(pt.lotl)
            trades.pop()
            pOn := false
        else
            box.set_right(pt.rb, bar_index)
            box.set_right(pt.wb, bar_index)
            line.set_x2(pt.el, bar_index)
            if not na(pt.lotl)
                label.set_x(pt.lotl, bar_index + 1)
    int bias = biasIn == "Лише шорт" ? -1 : biasIn == "Лише лонг" ? 1 : biasIn == "Обидва боки" ? 0 : biasIn == "Авто (за азією)" ? biasAuto : biasIn == "Тренд D (3 дні)" ? htfTr : (biasAuto == htfTr ? biasAuto : 0)
    curBias := bias
    bool biasKnown = biasIn == "Обидва боки" or bias != 0
    bool chainActive = chainOn and bar_index <= chainUntil
    bool friOk = not (dayofweek(time, "UTC") == dayofweek.friday and minOfDay >= friCut * 60)
    bool canTrade = not tOn and not pOn and tradeWin and dayR > dayLimit and wkR > wkLimit and friOk and (biasKnown or chainActive) and not na(atrV)
    bool entered = false
    int szL = lv.size()
    if szL > 0
        for i = 0 to szL - 1
            Lvl l = lv.get(i)
            if not l.swept
                if l.isHigh and high > l.hi + sweepMin
                    l.swept := true
                    l.sweepBar := bar_index
                    l.ext := high
                    if na(swHBar) or bar_index - swHBar > 36 or high > swHMax
                        swHBar := bar_index
                        swHMax := high
                if (not l.isHigh) and low < l.lo - sweepMin
                    l.swept := true
                    l.sweepBar := bar_index
                    l.ext := low
                    if na(swLBar) or bar_index - swLBar > 36 or low < swLMin
                        swLBar := bar_index
                        swLMin := low
                if l.swept
                    if showDead
                        line.set_extend(l.ln, extend.none)
                        line.set_x2(l.ln, bar_index)
                        line.set_color(l.ln, color.new(color.gray, 55))
                        line.set_style(l.ln, line.style_dotted)
                        line.set_width(l.ln, 1)
                        label.set_style(l.lb, label.style_none)
                        label.set_x(l.lb, bar_index)
                        label.set_text(l.lb, "✕ " + (l.n > 1 ? "пул " : "") + l.tag + "  знято")
                        label.set_textcolor(l.lb, color.new(color.gray, 35))
                    else
                        line.delete(l.ln)
                        label.delete(l.lb)
            if l.swept and not l.done
                if l.isHigh
                    l.ext := math.max(l.ext, high)
                else
                    l.ext := math.min(l.ext, low)
                bool crossBack = l.isHigh ? (close < l.lo and (bar_index == l.sweepBar or close[1] >= l.lo)) : (close > l.hi and (bar_index == l.sweepBar or close[1] <= l.hi))
                bool bodyOk = l.isHigh ? (close < open and (open - close) >= minBody * atrV) : (close > open and (close - open) >= minBody * atrV)
                if crossBack
                    l.done := true
                    string skip = ""
                    int sideX = l.isHigh ? -1 : 1
                    if not bodyOk
                        skip := "тіло свічки замале"
                    else if tOn or pOn
                        skip := "вже є позиція/лімітка"
                    else if not tradeWin
                        skip := "поза вікном входу"
                    else if dayR <= dayLimit
                        skip := "ліміт дня"
                    else if wkR <= wkLimit
                        skip := "ліміт тижня"
                    else if not friOk
                        skip := "п'ятниця після " + str.tostring(friCut, "0.0") + " UTC"
                    else if not (biasKnown or chainActive)
                        skip := "біас не визначено"
                    else if not (bias == 0 or bias == sideX or (chainActive and chainSide == sideX))
                        skip := "проти біасу"
                    else if (bar_index - l.born) < 3
                        skip := "рівень надто свіжий"
                    else if entered
                        skip := "вже є вхід на цьому барі"
                    if bodyOk and canTrade and not entered and (bar_index - l.born) >= 3 and (bias == 0 or bias == (l.isHigh ? -1 : 1) or (chainActive and chainSide == (l.isHigh ? -1 : 1)))
                        int side = l.isHigh ? -1 : 1
                        bool isLimit = entryMode != "Ринком на закритті"
                        float obOpen = open
                        if entryMode == "Лімітка на Open OB (свічка перед імпульсом)"
                            for k = 1 to 5
                                if (side == -1 ? close[k] > open[k] : close[k] < open[k])
                                    obOpen := open[k]
                                    break
                        float entry = isLimit ? obOpen : close
                        float maxDist = isFx ? entryFx * pip : entryAtr * atrV
                        if math.abs(close - l.ext) > maxDist
                            skip := "вхід далеко від екстремуму"
                        if math.abs(close - l.ext) <= maxDist
                            float buf = math.max(bufMult * atrV, minStop)
                            float sl = side == -1 ? l.ext + buf : l.ext - buf
                            float bestD = 1e10
                            float edge = na
                            for j = 0 to szL - 1
                                Lvl q = lv.get(j)
                                if not q.swept and q.isHigh == (side == -1)
                                    if side == -1 and q.lo > entry and (q.lo - entry) < bestD
                                        bestD := q.lo - entry
                                        edge := q.hi
                                    if side == 1 and q.hi < entry and (entry - q.hi) < bestD
                                        bestD := entry - q.hi
                                        edge := q.lo
                            if not na(edge)
                                sl := side == -1 ? math.max(sl, edge + 0.5 * pip) : math.min(sl, edge - 0.5 * pip)
                            float risk = math.abs(sl - entry)
                            if not (risk >= riskMinA * atrV and risk <= riskMaxA * atrV and risk >= minStop)
                                skip := "ризик поза межами"
                            if risk >= riskMinA * atrV and risk <= riskMaxA * atrV and risk >= minStop
                                float bestT = 1e10
                                float tp = na
                                for j = 0 to szL - 1
                                    Lvl q = lv.get(j)
                                    if not q.swept and q.isHigh == (side == 1)
                                        float px = side == -1 ? q.hi : q.lo
                                        float dist = side == -1 ? entry - px : px - entry
                                        if dist > 0 and dist / risk >= rrMin and dist < bestT
                                            bestT := dist
                                            tp := px
                                if na(tp)
                                    skip := "RR менше мінімуму / немає цілі"
                                if not na(tp)
                                    if isLimit
                                        pFvg := false
                                        pOn := true
                                        pSide := side
                                        pEntry := entry
                                        pSl := sl
                                        pTp := tp
                                        pBar := bar_index
                                        pExp := bar_index + pendBars
                                    else
                                        tOn := true
                                        tSide := side
                                        tEntry := entry
                                        tSl := sl
                                        tTp := tp
                                        tBar := bar_index
                                    tNSig += 1
                                    float rr = math.abs(tp - entry) / risk
                                    float rUsd = riskUsdIn > 0 ? riskUsdIn : accSize * riskPct / 100.0
                                    float perUnit = isFx ? fxPipVal : idxPtVal
                                    float riskU = risk / pip
                                    float lotRaw = riskU * perUnit > 0 ? rUsd / (riskU * perUnit) : 0.0
                                    float lot = math.max(math.floor(lotRaw / lotStep) * lotStep, lotStep)
                                    tLot := lot
                                    tRiskUsd := lot * riskU * perUnit
                                    string lotTxt = showLot ? "\n" + str.tostring(lot, "0.00") + " лот · $" + str.tostring(tRiskUsd, "0") : ""
                                    box rb = box.new(l.sweepBar, side == -1 ? sl : entry, bar_index + 1, side == -1 ? entry : sl, border_color = vis(color.new(colRisk, 40)), bgcolor = vis(color.new(colRisk, boxTr)), border_style = isLimit ? line.style_dashed : line.style_solid)
                                    box wb = box.new(l.sweepBar, side == -1 ? entry : tp, bar_index + 1, side == -1 ? tp : entry, border_color = vis(color.new(colRew, 40)), bgcolor = vis(color.new(colRew, boxTr)), border_style = isLimit ? line.style_dashed : line.style_solid)
                                    line el = line.new(l.sweepBar, entry, bar_index + 1, entry, color = vis(isLimit ? colPend : color.new(color.white, 20)), width = 2, style = isLimit ? line.style_dashed : line.style_solid, extend = isLimit ? extend.right : extend.none)
                                    label lb = label.new(l.sweepBar, entry, (isLimit ? "◔ ЛІМІТКА · чекає\n" : "") + (side == -1 ? "▼ ШОРТ " : "▲ ЛОНГ ") + fmt(entry) + "\nRR " + str.tostring(rr, "0.0") + " · " + str.tostring(risk / pip, "0.0") + unitTxt + lotTxt, style = label.style_label_right, color = vis(isLimit ? colPend : color.new(#2962ff, 5)), textcolor = vis(isLimit ? color.black : color.white), size = lblSize)
                                    label lotLb = showLot ? label.new(bar_index + 1, entry, "ЛОТ " + str.tostring(lot, "0.00") + "\n$" + str.tostring(tRiskUsd, "0") + " ризику", style = label.style_label_left, color = vis(color.new(#ffd600, 0)), textcolor = vis(color.black), size = lotSz) : na
                                    trades.push(Trd.new(rb, wb, el, lb, na, side, entry, sl, tp, na, true, false, false, na, na, lotLb, na))
                                    trimTrades()
                                    if not isLimit
                                        sendAlert("🟢 " + syminfo.ticker + (side == -1 ? " ШОРТ " : " ЛОНГ ") + fmt(entry) + " | SL " + fmt(sl) + " | TP " + fmt(tp) + " | RR " + str.tostring(rr, "0.00") + " | " + str.tostring(risk / pip, "0.0") + unitTxt + " | " + str.tostring(lot, "0.00") + " лот ($" + str.tostring(tRiskUsd, "0") + ")")
                                    entered := true
                else if bar_index - l.sweepBar >= maxAge
                    l.done := true

    // --- M15-свічки з барів M5 + FVG-ліміт ноги зняття
    if time % 900000 == 0 or na(cH)
        cO := open
        cH := high
        cL := low
    else
        cH := math.max(cH, high)
        cL := math.min(cL, low)
    cC := close
    if not na(swHBar) and bar_index > swHBar
        swHMax := math.max(swHMax, high)
    if not na(swLBar) and bar_index > swLBar
        swLMin := math.min(swLMin, low)
    bool m15Last = (time + 300000) % 900000 == 0
    bool canFvg = fvgBase ? (not tOn and not pOn and inSess and dayR > dayLimit and wkR > wkLimit and friOk and (biasKnown or chainActive) and not na(atrV)) : canTrade
    if fvgOn and m15Last and canFvg and not entered and not na(o1) and not na(o2) and not na(atrV)
        for dirn = -1 to 1 by 2
            int swB = dirn == -1 ? swHBar : swLBar
            float swE = dirn == -1 ? swHMax : swLMin
            if not entered and not na(swB) and bar_index - swB <= 36 and (bias == 0 or bias == dirn)
                float gLo = dirn == -1 ? cH : h1
                float gHi = dirn == -1 ? l1 : cL
                bool okG = gHi > gLo and (gHi - gLo) >= fvgMin * pip and (dirn == -1 ? c2 < o2 : c2 > o2)
                if okG
                    float fEntry = dirn == -1 ? gLo : gHi
                    float fSl = dirn == -1 ? swE + fvgBuf * pip : swE - fvgBuf * pip
                    float fRisk = math.abs(fSl - fEntry)
                    if fRisk >= riskMinA * atrV and fRisk <= fvgRiskAtr * atrV and fRisk >= minStop
                        float fBest = 1e10
                        float fTp = na
                        int nF = lv.size()
                        if nF > 0
                            for j = 0 to nF - 1
                                Lvl q = lv.get(j)
                                if not q.swept and q.isHigh == (dirn == 1)
                                    float fpx = dirn == -1 ? q.hi : q.lo
                                    float fdist = dirn == -1 ? fEntry - fpx : fpx - fEntry
                                    if fdist > 0 and fdist / fRisk >= rrMin and fdist < fBest
                                        fBest := fdist
                                        fTp := fpx
                        if not na(fTp)
                            pFvg := true
                            pInval := swE
                            pOn := true
                            pSide := dirn
                            pEntry := fEntry
                            pSl := fSl
                            pTp := fTp
                            pBar := bar_index
                            pExp := bar_index + fvgExp
                            tNSig += 1
                            float fRr = math.abs(fTp - fEntry) / fRisk
                            float fUsd = riskUsdIn > 0 ? riskUsdIn : accSize * riskPct / 100.0
                            float fUnit = isFx ? fxPipVal : idxPtVal
                            float fRu = fRisk / pip
                            float fLotRaw = fRu * fUnit > 0 ? fUsd / (fRu * fUnit) : 0.0
                            float fLot = math.max(math.floor(fLotRaw / lotStep) * lotStep, lotStep)
                            tLot := fLot
                            tRiskUsd := fLot * fRu * fUnit
                            string fLotTxt = showLot ? "\n" + str.tostring(fLot, "0.00") + " лот · $" + str.tostring(tRiskUsd, "0") : ""
                            box frb = box.new(swB, dirn == -1 ? fSl : fEntry, bar_index + 1, dirn == -1 ? fEntry : fSl, border_color = vis(color.new(colRisk, 40)), bgcolor = vis(color.new(colRisk, boxTr)), border_style = line.style_dashed)
                            box fwb = box.new(swB, dirn == -1 ? fEntry : fTp, bar_index + 1, dirn == -1 ? fTp : fEntry, border_color = vis(color.new(colRew, 40)), bgcolor = vis(color.new(colRew, boxTr)), border_style = line.style_dashed)
                            line fel = line.new(swB, fEntry, bar_index + 1, fEntry, color = vis(colPend), width = 2, style = line.style_dashed, extend = extend.right)
                            label flb = label.new(swB, fEntry, "◔ ЛІМІТКА · чекає\nFVG M15 · " + (dirn == -1 ? "▼ ШОРТ " : "▲ ЛОНГ ") + fmt(fEntry) + "\nRR " + str.tostring(fRr, "0.0") + " · " + str.tostring(fRu, "0.0") + unitTxt + fLotTxt, style = label.style_label_right, color = vis(colPend), textcolor = vis(color.black), size = lblSize)
                            label fLotLb = showLot ? label.new(bar_index + 1, fEntry, "ЛОТ " + str.tostring(fLot, "0.00") + "\n$" + str.tostring(tRiskUsd, "0") + " ризику", style = label.style_label_left, color = vis(color.new(#ffd600, 0)), textcolor = vis(color.black), size = lotSz) : na
                            trades.push(Trd.new(frb, fwb, fel, flb, na, dirn, fEntry, fSl, fTp, na, true, false, false, na, na, fLotLb, na))
                            trimTrades()
                            entered := true
    if m15Last
        o1 := o2
        h1 := h2
        l1 := l2
        c1 := c2
        o2 := cO
        h2 := cH
        l2 := cL
        c2 := cC

    // --- супровід відкритої угоди
    if tOn and bar_index > tBar
        Trd cur = trades.last()
        box.set_right(cur.rb, bar_index)
        if not na(cur.lotl)
            label.set_x(cur.lotl, bar_index + 1)
        box.set_right(cur.wb, bar_index)
        line.set_x2(cur.el, bar_index)
        bool hitSl = tSide == -1 ? high >= tSl : low <= tSl
        bool hitTp = tSide == -1 ? low <= tTp : high >= tTp
        float exitPx = na
        string why = ""
        if hitSl
            exitPx := tSl
            why := "СТОП"
        else if hitTp
            exitPx := tTp
            why := "ЦІЛЬ"
        else if minOfDay >= sessTo - 5
            exitPx := close
            why := "ЗАКРИТО ПО ЧАСУ"
        if not na(exitPx)
            float riskX = math.abs(tEntry - tSl)
            float rX = tSide * (exitPx - tEntry) / riskX
            dayR += rX
            wkR += rX
            if why == "ЦІЛЬ"
                chainSide := -tSide
                chainUntil := bar_index + 8
            lastR := rX
            cur.r := rX
            cur.open := false
            cur.xbar := bar_index
            if why == "СТОП"
                cur.sh := true
                cur.tln := line.new(bar_index, cur.tp, bar_index, cur.tp, color = vis(color.new(colRew, 25)), style = line.style_dotted, width = 2)
            cur.xl := label.new(bar_index, exitPx, why + "  " + sgn(rX) + "R", style = label.style_label_left, color = vis(rX > 0 ? color.new(colRew, 0) : rX < 0 ? color.new(colRisk, 0) : color.new(color.gray, 0)), textcolor = vis(color.white), size = lblSize)
            sendAlert((rX > 0 ? "🎯 " : "🔴 ") + syminfo.ticker + " " + why + " " + fmt(exitPx) + " · " + sgn(rX) + "R · день " + sgn(dayR) + "R")
            tOn := false

    // --- після стопу: чи дійшла б ціль пізніше (бокс цілі тягнеться до неї або до кінця сесії)
    int nSh = trades.size()
    if nSh > 0
        for i = 0 to nSh - 1
            Trd sh = trades.get(i)
            if sh.sh and bar_index > sh.xbar
                bool reached = sh.side == -1 ? low <= sh.tp : high >= sh.tp
                line.set_x2(sh.tln, bar_index)
                if reached
                    sh.sh := false
                    sh.late := true
                    sh.tl := label.new(bar_index, sh.tp, "ціль пізніше ✓", style = label.style_label_left, color = vis(color.new(colRew, 35)), textcolor = vis(color.white), size = lblSize)
                else if minOfDay >= sessTo - 5 or newDay
                    sh.sh := false

    // --- денні екстремуми (після логіки зняття, щоб зняття старого екстремуму було видно)
    bool newHigh = high > dayH
    bool newLow = low < dayL
    if newHigh
        dayH := high
    if newLow
        dayL := low
    if showLvls
        if newHigh
            addLevel(dayH, true, "DAY")
        if newLow
            addLevel(dayL, false, "DAY")
    int k = lv.size() - 1
    while k >= 0
        Lvl q2 = lv.get(k)
        if q2.tag == "DAY" and q2.swept and q2.done
            dropLvl(k)
        k -= 1

    // --- зони
    if showFvg or showOb
        procHtf("H1", showH1, 3.0 * pip * fvgScl, tH1, tH1[1], tH1a, tH1b, tH1c, oH1_1, hH1_1, lH1_1, cH1_1, oH1_2, hH1_2, lH1_2, cH1_2, oH1_3, hH1_3, lH1_3, cH1_3, oH1_4, hH1_4, lH1_4, cH1_4, oH1_5, hH1_5, lH1_5, cH1_5, avH1)
        procHtf("H4", showH4, 5.0 * pip * fvgScl, tH4, tH4[1], tH4a, tH4b, tH4c, oH4_1, hH4_1, lH4_1, cH4_1, oH4_2, hH4_2, lH4_2, cH4_2, oH4_3, hH4_3, lH4_3, cH4_3, oH4_4, hH4_4, lH4_4, cH4_4, oH4_5, hH4_5, lH4_5, cH4_5, avH4)
        procHtf("D", showD, 15.0 * pip * fvgScl, tD1, tD1[1], tD1a, tD1b, tD1c, oD_1, hD_1, lD_1, cD_1, oD_2, hD_2, lD_2, cD_2, oD_3, hD_3, lD_3, cD_3, oD_4, hD_4, lD_4, cD_4, oD_5, hD_5, lD_5, cD_5, avD)
        updateZones()

// ───────────── Структура ринку на поточному ТФ: BOS / Shift / боковик
float phS = ta.pivothigh(high, swLen, swLen)
float plS = ta.pivotlow(low, swLen, swLen)
[diPl, diMi, adxV] = ta.dmi(14, 14)
float rHi = ta.highest(high, rngLen)
float rLo = ta.lowest(low, rngLen)

var float sh1 = na
var float sh2 = na
var int   sh1i = na
var int   sh2i = na
var float sl1 = na
var float sl2 = na
var int   sl1i = na
var int   sl2i = na
var int   strTrend = 0
var bool  brkH = true
var bool  brkL = true
var string lastStruct = "—"
var array<line>  mLines  = array.new<line>()
var array<label> mLabels = array.new<label>()
var array<box>   rngBoxes = array.new<box>()
var bool  inRng = false
var box   rngBox = na
var float rngHiV = na
var float rngLoV = na
var int   rngStart = na

if barstate.isconfirmed
    if not na(phS)
        sh2 := sh1
        sh2i := sh1i
        sh1 := phS
        sh1i := bar_index - swLen
        brkH := false
    if not na(plS)
        sl2 := sl1
        sl2i := sl1i
        sl1 := plS
        sl1i := bar_index - swLen
        brkL := false
    // --- злам вгору (BOS ▲ або Shift ▲)
    if not brkH and not na(sh1) and close > sh1
        brkH := true
        bool isShift = strTrend == -1
        strTrend := 1
        lastStruct := isShift ? "Shift ▲" : "BOS ▲"
        if showStruct
            line ln = line.new(sh1i, sh1, bar_index, sh1, color = isShift ? colShift : colBos, width = 2, style = line.style_dashed)
            label lb = label.new(math.round(math.avg(sh1i, bar_index)), sh1, lastStruct, style = label.style_label_down, color = color.new(isShift ? colShift : colBos, 10), textcolor = isShift ? color.black : color.white, size = lblSize)
            mLines.push(ln)
            mLabels.push(lb)
    // --- злам вниз (BOS ▼ або Shift ▼)
    if not brkL and not na(sl1) and close < sl1
        brkL := true
        bool isShift = strTrend == 1
        strTrend := -1
        lastStruct := isShift ? "Shift ▼" : "BOS ▼"
        if showStruct
            line ln = line.new(sl1i, sl1, bar_index, sl1, color = isShift ? colShift : colBos, width = 2, style = line.style_dashed)
            label lb = label.new(math.round(math.avg(sl1i, bar_index)), sl1, lastStruct, style = label.style_label_up, color = color.new(isShift ? colShift : colBos, 10), textcolor = isShift ? color.black : color.white, size = lblSize)
            mLines.push(ln)
            mLabels.push(lb)
    while mLines.size() > maxMarks
        line.delete(mLines.shift())
        label.delete(mLabels.shift())
    // --- боковик
    if showRange
        bool compact = not na(atrV) and bar_index > rngLen and (rHi - rLo) <= rngMaxAtr * atrV and adxV < adxMax and math.abs(close - close[rngLen - 1]) <= 0.5 * (rHi - rLo)
        if not inRng and compact
            inRng := true
            rngHiV := rHi
            rngLoV := rLo
            rngStart := bar_index - rngLen + 1
            rngBox := box.new(rngStart, rngHiV, bar_index + 1, rngLoV, border_color = colRng, border_width = 2, border_style = line.style_dashed, bgcolor = color.new(colRng, 86), text = "Акумуляція · боковик", text_color = color.new(colRng, 0), text_size = lblSize, text_halign = text.align_left, text_valign = text.align_top)
            rngBoxes.push(rngBox)
            if rngBoxes.size() > 10
                box.delete(rngBoxes.shift())
        else if inRng
            bool outUp = close > rngHiV + 0.2 * nz(atrV, 0.0)
            bool outDn = close < rngLoV - 0.2 * nz(atrV, 0.0)
            bool tooTall = (rngHiV - rngLoV) > 1.5 * rngMaxAtr * nz(atrV, 1.0)
            if outUp or outDn or tooTall
                inRng := false
                box.set_text(rngBox, "Акумуляція · боковик · " + str.tostring(bar_index - rngStart) + " барів" + (outUp ? " → вихід ▲" : outDn ? " → вихід ▼" : ""))
                box.set_right(rngBox, bar_index)
            else
                rngHiV := math.max(rngHiV, high)
                rngLoV := math.min(rngLoV, low)
                box.set_top(rngBox, rngHiV)
                box.set_bottom(rngBox, rngLoV)
                box.set_right(rngBox, bar_index)
                box.set_text(rngBox, "Акумуляція · боковик · " + str.tostring(bar_index - rngStart + 1) + " барів")

// ───────────── AMD: Accumulation (Азія) → Manipulation (зняття меж Азії) → Distribution
var array<box>   amBoxes = array.new<box>()
var array<label> amLbls  = array.new<label>()
var box    amBox = na
var int    asBar0 = na
var float  asOpen0 = na
var int    amState = 0
var bool   amDone = false
var string amInfo = "—"
if barstate.isconfirmed and showAmd
    if asStart
        asBar0 := bar_index
        asOpen0 := open
    if asEnd and not na(asH) and not na(asL) and not na(atrV)
        amState := 0
        amDone := false
        amBox := na
        amInfo := "Азія вузька"
        if (asH - asL) >= 3.0 * atrV and math.abs(close - nz(asOpen0, close)) > amNetMax * (asH - asL)
            amInfo := "Азія трендова: A не визначено"
        if (asH - asL) >= 3.0 * atrV and math.abs(close - nz(asOpen0, close)) <= amNetMax * (asH - asL)
            amBox := box.new(nz(asBar0, bar_index - 96), asH, bar_index, asL, border_color = colAcc, border_width = 2, bgcolor = color.new(colAcc, 88), text = "A · Акумуляція (Азія) · " + str.tostring((asH - asL) / pip, "0") + unitTxt, text_color = colAcc, text_size = lblSize, text_halign = text.align_left, text_valign = text.align_top)
            amBoxes.push(amBox)
            if amBoxes.size() > 4
                box.delete(amBoxes.shift())
            amInfo := "A ✓ " + str.tostring((asH - asL) / pip, "0") + unitTxt
    int hUtc = hour(time, "UTC")
    if not na(amBox) and not inAsia and hUtc < 16
        box.set_right(amBox, bar_index)
    bool amWin = not na(amBox) and not inAsia and hUtc >= 6 and hUtc < 14
    if amWin and amState == 0
        bool upSw = high > asH + sweepMin
        bool dnSw = low < asL - sweepMin
        if upSw and not dnSw
            amState := 1
            amInfo := "A ✓ → M ▲ " + str.format_time(time, "HH:mm", "UTC") + " → D ▼ ?"
            amLbls.push(label.new(bar_index, high, "M ▲ Manipulation · знято максимум Азії", style = label.style_label_down, color = color.new(colMan, 5), textcolor = color.black, size = lblSize))
        else if dnSw and not upSw
            amState := -1
            amInfo := "A ✓ → M ▼ " + str.format_time(time, "HH:mm", "UTC") + " → D ▲ ?"
            amLbls.push(label.new(bar_index, low, "M ▼ Manipulation · знято мінімум Азії", style = label.style_label_up, color = color.new(colMan, 5), textcolor = color.black, size = lblSize))
    if not na(amBox) and amState != 0 and not amDone and not inAsia
        if amState == 1 and close < asL
            amDone := true
            amInfo := "A ✓ → M ▲ → D ▼ ✓"
            amLbls.push(label.new(bar_index, close, "D ▼ Distribution · закриття нижче Азії", style = label.style_label_up, color = color.new(colDis, 5), textcolor = color.black, size = lblSize))
        else if amState == -1 and close > asH
            amDone := true
            amInfo := "A ✓ → M ▼ → D ▲ ✓"
            amLbls.push(label.new(bar_index, close, "D ▲ Distribution · закриття вище Азії", style = label.style_label_down, color = color.new(colDis, 5), textcolor = color.black, size = lblSize))
    while amLbls.size() > 12
        label.delete(amLbls.shift())

// ───────────── Де буде найближчий Shift / BOS (рівні-тригери)
var line  shLn = na
var line  bsLn = na
var label shLb = na
var label bsLb = na
if barstate.islast
    line.delete(shLn)
    line.delete(bsLn)
    label.delete(shLb)
    label.delete(bsLb)
    if showShiftLvl and strTrend != 0
        float shP = strTrend == 1 ? sl1 : sh1
        int   shI = strTrend == 1 ? sl1i : sh1i
        float bsP = strTrend == 1 ? sh1 : sl1
        int   bsI = strTrend == 1 ? sh1i : sl1i
        if not na(shP)
            shLn := line.new(shI, shP, bar_index + 12, shP, color = colShift, width = 2, style = line.style_dotted, extend = extend.right)
            shLb := label.new(bar_index - 30, shP, "SHIFT " + (strTrend == 1 ? "▼ якщо закриття нижче " : "▲ якщо закриття вище ") + fmt(shP) + "  (" + (strTrend == 1 ? "−" : "+") + str.tostring(math.abs(close - shP) / pip, "0.0") + unitTxt + ")", style = label.style_label_down, color = color.new(colShift, 5), textcolor = color.black, size = lblSize)
        if not na(bsP)
            bsLn := line.new(bsI, bsP, bar_index + 12, bsP, color = colBos, width = 1, style = line.style_dotted, extend = extend.right)
            bsLb := label.new(bar_index - 30, bsP, "BOS " + (strTrend == 1 ? "▲ якщо закриття вище " : "▼ якщо закриття нижче ") + fmt(bsP) + "  (" + (strTrend == 1 ? "+" : "−") + str.tostring(math.abs(close - bsP) / pip, "0.0") + unitTxt + ")", style = label.style_label_up, color = color.new(colBos, 15), textcolor = color.white, size = lblSize)

// ───────────── Найближча підтримка й найближчий опір (завжди, зі «свіченням»)
tfName(string tf) => tf == "D" ? "Daily" : tf
lvName(string tag) => tag == "PDH" ? "вчорашній максимум (PDH)" : tag == "PDL" ? "вчорашній мінімум (PDL)" : tag == "ASIA H" ? "максимум азії" : tag == "ASIA L" ? "мінімум азії" : tag == "DAY" ? "екстремум дня" : tag == "H1" ? "свінг H1" : tag == "D" ? "свінг Daily" : tag
var box resB = na
var box supB = na
var box resG1 = na
var box resG2 = na
var box supG1 = na
var box supG2 = na
var label resL = na
var label supL = na
if barstate.islast
    box.delete(resB)
    box.delete(supB)
    box.delete(resG1)
    box.delete(resG2)
    box.delete(supG1)
    box.delete(supG2)
    label.delete(resL)
    label.delete(supL)
    if showNear
        float upD = 1e10
        float dnD = 1e10
        float upLo = na
        float upHi = na
        float dnLo = na
        float dnHi = na
        string upT = ""
        string dnT = ""
        string upX = ""
        string dnX = ""
        int nzz = zn.size()
        if nzz > 0
            for i = 0 to nzz - 1
                Zn z = zn.get(i)
                if not z.dead
                    string nm = tfName(z.tf) + (z.isFvg ? " FVG" : " Order Block") + (z.bull ? " ▲" : " ▼")
                    string dsc = z.isFvg ? "FVG — гап справедливої вартості (дисбаланс цін)" : "Order Block — остання свічка перед імпульсом"
                    bool inside = z.bot <= close and close <= z.top
                    bool asSup = inside ? close >= (z.top + z.bot) / 2 : z.top < close
                    bool asRes = inside ? not asSup : z.bot > close
                    if asSup
                        float d = inside ? 0.0 : close - z.top
                        if d < dnD
                            dnD := d
                            dnLo := z.bot
                            dnHi := z.top
                            dnT := nm
                            dnX := dsc
                    if asRes
                        float d = inside ? 0.0 : z.bot - close
                        if d < upD
                            upD := d
                            upLo := z.bot
                            upHi := z.top
                            upT := nm
                            upX := dsc
        if na(upLo) or na(dnLo)
            float lvUp = 1e10
            float lvDn = 1e10
            float uLo = na
            float uHi = na
            float dLo = na
            float dHi = na
            string uT = ""
            string dT = ""
            int nl = lv.size()
            if nl > 0
                for i = 0 to nl - 1
                    Lvl q = lv.get(i)
                    if not q.swept
                        if q.isHigh and q.lo > close and q.lo - close < lvUp
                            lvUp := q.lo - close
                            uLo := q.lo
                            uHi := q.hi + 0.5 * pip
                            uT := lvName(q.tag)
                        if (not q.isHigh) and q.hi < close and close - q.hi < lvDn
                            lvDn := close - q.hi
                            dLo := q.lo - 0.5 * pip
                            dHi := q.hi
                            dT := lvName(q.tag)
            if na(upLo) and not na(uLo)
                upD := lvUp
                upLo := uLo
                upHi := uHi
                upT := uT
                upX := "рівень ліквідності (пул)"
            if na(dnLo) and not na(dLo)
                dnD := lvDn
                dnLo := dLo
                dnHi := dHi
                dnT := dT
                dnX := "рівень ліквідності (пул)"
        float gw = 0.35 * atrV
        if not na(upLo)
            resG2 := box.new(bar_index - 60, upHi + 2 * gw, bar_index + 12, upLo - 2 * gw, border_color = na, bgcolor = color.new(colRes, 94), extend = extend.right)
            resG1 := box.new(bar_index - 60, upHi + gw, bar_index + 12, upLo - gw, border_color = na, bgcolor = color.new(colRes, 88), extend = extend.right)
            resB := box.new(bar_index - 60, upHi, bar_index + 12, upLo, border_color = colRes, border_width = 3, bgcolor = color.new(colRes, 68), extend = extend.right)
            resL := label.new(bar_index - 26, upHi + gw, "ОПІР · " + upT + "  +" + str.tostring(upD / pip, "0.0") + unitTxt + "\n" + upX, style = label.style_label_down, color = color.new(colRes, 5), textcolor = color.white, size = lblSize)
        if not na(dnLo)
            supG2 := box.new(bar_index - 60, dnHi + 2 * gw, bar_index + 12, dnLo - 2 * gw, border_color = na, bgcolor = color.new(colSup, 94), extend = extend.right)
            supG1 := box.new(bar_index - 60, dnHi + gw, bar_index + 12, dnLo - gw, border_color = na, bgcolor = color.new(colSup, 88), extend = extend.right)
            supB := box.new(bar_index - 60, dnHi, bar_index + 12, dnLo, border_color = colSup, border_width = 3, bgcolor = color.new(colSup, 68), extend = extend.right)
            supL := label.new(bar_index - 26, dnLo - gw, "ПІДТРИМКА · " + dnT + "  −" + str.tostring(dnD / pip, "0.0") + unitTxt + "\n" + dnX, style = label.style_label_up, color = color.new(colSup, 5), textcolor = color.black, size = lblSize)

// ───────────── Підписи рівнів — до правого краю на останньому барі
if barstate.islast
    int n = lv.size()
    if n > 0
        for i = 0 to n - 1
            Lvl l2 = lv.get(i)
            if not l2.swept
                label.set_x(l2.lb, bar_index + 3)

// ───────────── Допоміжні лінії
plot(showSessLines ? pdc : na, "PDC (закриття вчора)", color = colPDC, style = plot.style_linebr)
dcO = request.security(syminfo.tickerid, "D", open, lookahead = barmerge.lookahead_on)
dOpenVal = dailyMode == "Свічка D (17:00 Нью-Йорк)" ? dcO : dOpenNY
plot(showSessLines ? dOpenVal : na, "Daily Open", color = colDO, style = plot.style_linebr, linewidth = 2)
plot(showPD ? pdHD : na, "Prev Day High", color = colPDH, style = plot.style_linebr, linewidth = 2)
plot(showPD ? pdLD : na, "Prev Day Low", color = colPDL, style = plot.style_linebr, linewidth = 2)
plot(showWeek ? wkO : na, "Weekly Open", color = colWO, style = plot.style_linebr, linewidth = 2)
plot(showWeek ? pwH : na, "Prev Week High", color = colPWH, style = plot.style_linebr, linewidth = 2)
plot(showWeek ? pwL : na, "Prev Week Low", color = colPWL, style = plot.style_linebr, linewidth = 2)
plot(showNyO ? nyO : na, "New York Open", color = colNY, style = plot.style_linebr, linewidth = 2)

// ───────────── Підписи ключових відкриттів і тижневих рівнів (справа)
keySize = keySizeIn == "Малий" ? size.small : keySizeIn == "Великий" ? size.large : size.normal
var label kDO = na
var label kPDH = na
var label kPDL = na
var label kWO = na
var label kPWH = na
var label kPWL = na
var label kNY = na
if barstate.islast
    label.delete(kDO)
    label.delete(kPDH)
    label.delete(kPDL)
    label.delete(kWO)
    label.delete(kPWH)
    label.delete(kPWL)
    label.delete(kNY)
    if showSessLines and not na(dOpenVal)
        kDO := label.new(bar_index + 2, dOpenVal, "Daily Open  " + fmt(dOpenVal), style = label.style_label_left, color = colDO, textcolor = color.white, size = keySize)
    if showPD and not na(pdHD)
        kPDH := label.new(bar_index + 2, pdHD, "Prev Day High  " + fmt(pdHD), style = label.style_label_left, color = colPDH, textcolor = color.white, size = keySize)
    if showPD and not na(pdLD)
        kPDL := label.new(bar_index + 2, pdLD, "Prev Day Low  " + fmt(pdLD), style = label.style_label_left, color = colPDL, textcolor = color.black, size = keySize)
    if showWeek and not na(wkO)
        kWO := label.new(bar_index + 2, wkO, "Weekly Open  " + fmt(wkO), style = label.style_label_left, color = colWO, textcolor = color.black, size = keySize)
    if showWeek and not na(pwH)
        kPWH := label.new(bar_index + 2, pwH, "Prev Week High  " + fmt(pwH), style = label.style_label_left, color = colPWH, textcolor = color.black, size = keySize)
    if showWeek and not na(pwL)
        kPWL := label.new(bar_index + 2, pwL, "Prev Week Low  " + fmt(pwL), style = label.style_label_left, color = colPWL, textcolor = color.black, size = keySize)
    if showNyO and not na(nyO)
        kNY := label.new(bar_index + 2, nyO, "New York Open  " + fmt(nyO), style = label.style_label_left, color = colNY, textcolor = color.white, size = keySize)

// ───────────── Таблиця стану
var table tb = table.new(position.top_right, 2, 15, bgcolor = color.new(#131722, 12), border_color = color.new(color.gray, 70), border_width = 1, frame_color = color.new(color.gray, 60), frame_width = 1)
if barstate.islast and showTable
    float sumR = 0.0
    int wins = 0
    int loss = 0
    int lateN = 0
    int stopN = 0
    int tn = trades.size()
    if tn > 0
        for i = 0 to tn - 1
            Trd t = trades.get(i)
            if not t.open and not na(t.r)
                sumR += t.r
                if t.r > 0
                    wins += 1
                else if t.r < 0
                    loss += 1
                    stopN += 1
                    if t.late
                        lateN += 1
    string bTxt = curBias == -1 ? "ВНИЗ" : curBias == 1 ? "ВГОРУ" : biasIn == "Обидва боки" ? "обидва боки" : "немає"
    bTxt += biasIn == "Тренд D (3 дні)" ? " · тренд D" : biasIn == "Азія + тренд D" ? " · азія+D" : biasIn == "Авто (за азією)" ? " · азія" : ""
    color bCol = curBias == -1 ? colRisk : curBias == 1 ? colRew : color.gray
    table.merge_cells(tb, 0, 0, 1, 0)
    table.cell(tb, 0, 0, "Owner Method · " + syminfo.ticker, text_color = color.white, text_size = size.small, bgcolor = color.new(#2962ff, 25))
    table.cell(tb, 0, 1, "Біас дня", text_color = color.new(color.white, 25), text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 1, bTxt, text_color = bCol, text_size = size.small, text_halign = text.align_right)
    table.cell(tb, 0, 2, "ATR(" + str.tostring(atrLen) + ")", text_color = color.new(color.white, 25), text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 2, str.tostring(atrV / pip, "0.0") + unitTxt, text_color = color.white, text_size = size.small, text_halign = text.align_right)
    table.cell(tb, 0, 3, "Результат дня", text_color = color.new(color.white, 25), text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 3, sgn(dayR) + " R", text_color = dayR >= 0 ? colRew : colRisk, text_size = size.small, text_halign = text.align_right)
    table.cell(tb, 0, 4, pOn ? "Лімітка" : "Угода зараз", text_color = color.new(color.white, 25), text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 4, tOn ? (tSide == -1 ? "ШОРТ " : "ЛОНГ ") + fmt(tEntry) : pOn ? (pSide == -1 ? "ШОРТ " : "ЛОНГ ") + fmt(pEntry) : "—", text_color = color.white, text_size = size.small, text_halign = text.align_right)
    table.cell(tb, 0, 5, "Стоп / ціль", text_color = color.new(color.white, 25), text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 5, tOn ? fmt(tSl) + " / " + fmt(tTp) : pOn ? fmt(pSl) + " / " + fmt(pTp) : "—", text_color = color.white, text_size = size.small, text_halign = text.align_right)
    table.cell(tb, 0, 6, "Торгове вікно", text_color = color.new(color.white, 25), text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 6, tradeWin ? "відкрите" : "закрите", text_color = tradeWin ? colRew : color.gray, text_size = size.small, text_halign = text.align_right)
    table.cell(tb, 0, 7, "Останні " + str.tostring(tn) + " угод", text_color = color.new(color.white, 25), text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 7, str.tostring(wins) + " + / " + str.tostring(loss) + " −", text_color = color.white, text_size = size.small, text_halign = text.align_right)
    table.cell(tb, 0, 8, "Сума останніх", text_color = color.new(color.white, 25), text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 8, sgn(sumR) + " R", text_color = sumR >= 0 ? colRew : colRisk, text_size = size.small, text_halign = text.align_right)
    table.cell(tb, 0, 9, "Стопи → ціль пізніше", text_color = color.new(color.white, 25), text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 9, str.tostring(lateN) + " з " + str.tostring(stopN), text_color = color.white, text_size = size.small, text_halign = text.align_right)
    float rNow = riskUsdIn > 0 ? riskUsdIn : accSize * riskPct / 100.0
    table.cell(tb, 0, 10, "Ризик на угоду", text_color = color.new(color.white, 25), text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 10, "$" + str.tostring(rNow, "0") + (riskUsdIn > 0 ? "" : "  (" + str.tostring(riskPct, "0.0#") + "%)"), text_color = color.white, text_size = size.small, text_halign = text.align_right)
    table.cell(tb, 0, 11, tOn ? "Обсяг відкритої" : "Обсяг останньої", text_color = color.new(color.white, 25), text_size = size.large, text_halign = text.align_left)
    table.cell(tb, 1, 11, na(tLot) ? "—" : str.tostring(tLot, "0.00") + " лот", text_color = color.white, text_size = size.large, text_halign = text.align_right)
    table.cell(tb, 0, 12, "Структура (цей ТФ)", text_color = color.new(color.white, 25), text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 12, (strTrend == 1 ? "тренд ВГОРУ" : strTrend == -1 ? "тренд ВНИЗ" : "—") + " · " + lastStruct, text_color = strTrend == 1 ? colRew : strTrend == -1 ? colRisk : color.gray, text_size = size.small, text_halign = text.align_right)
    table.cell(tb, 0, 13, "Боковик", text_color = color.new(color.white, 25), text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 13, inRng ? "ТАК · " + str.tostring(bar_index - rngStart + 1) + " барів" : "ні", text_color = inRng ? colRng : color.gray, text_size = size.small, text_halign = text.align_right)
    table.cell(tb, 0, 14, "AMD (Азія)", text_color = color.new(color.white, 25), text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 14, showAmd ? amInfo : "вимкнено", text_color = amDone ? colDis : amState != 0 ? colMan : colAcc, text_size = size.small, text_halign = text.align_right)

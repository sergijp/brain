//@version=5
// Owner Method — Map + Setups  (v0.48, 14.10.2026: свінги SH зелені/SL червоні, окремі перемикачі позицій і ліміток, лічильники, мін. ширина позиції)
// Карта ліквідності і зон + детектор сетапу «зняття пулу → імпульсний реклейм» + супровід угод + історія останніх угод.
// Працювати на M5. Стан змінюється лише на закритих барах (без перемальовування).
indicator("тестовий мій", shorttitle="тестовий мій", overlay=true, max_lines_count=500, max_boxes_count=500, max_labels_count=500)

// ═════════════ 1 · БІАС І ТОРГОВИЙ ЧАС ═════════════
g1 = "1 · Біас і торговий час"
biasIn   = input.string("Тренд D (3 дні)", "Напрям торгівлі (біас дня)", options=["Тренд D (3 дні)", "Азія + тренд D", "Авто (за азією)", "Лише шорт", "Лише лонг", "Обидва боки"], group=g1, tooltip="Тренд D: торгуємо за напрямом денного тренду (закриття вчора проти закриття 4 дні тому). Азія + тренд D: обидва сигнали мають збігатися. Авто (за азією): екстремум азії на рівні карти + достатній діапазон. За бектестом 08–10.2026 (EURUSD, GBPUSD, GER40) найкращий результат давав «Тренд D», а «Авто (за азією)» — найгірший.")
kzMode   = input.string("Лондон + Нью-Йорк", "Вікна входу (killzone)", options=["Лондон + Нью-Йорк", "Весь торговий час"], group=g1, tooltip="Нові входи лише у вікнах активності ліквідності. Вихід по часу і супровід працюють завжди.")
kz1a     = input.float(7.0, "Лондон: з (година UTC)", step=0.5, group=g1, inline="k1")
kz1b     = input.float(10.0, "до", step=0.5, group=g1, inline="k1")
kz2a     = input.float(12.5, "Нью-Йорк: з (година UTC)", step=0.5, group=g1, inline="k2")
kz2b     = input.float(16.0, "до", step=0.5, group=g1, inline="k2")
sessFromH = input.int(5, "Початок торгів — година UTC", minval=0, maxval=23, group=g1, inline="a")
sessFromM = input.int(50, "хвилина", minval=0, maxval=59, group=g1, inline="a")
sessToH   = input.int(19, "Кінець торгів / примусове закриття — година UTC", minval=0, maxval=23, group=g1, inline="b")
sessToM   = input.int(0, "хвилина", minval=0, maxval=59, group=g1, inline="b")
dayLimit  = input.float(-3.0, "Денна межа збитку, R (після неї нових угод немає)", group=g1)
maxPos    = input.int(2, "Макс. одночасних позицій і ліміток", minval=1, maxval=5, group=g1, tooltip="1 — як раніше: нова позиція лише коли попередня закрита. 2 і більше — індикатор домальовує додаткові позиції, коли з'являється ще один сетап (підтвердження, продовження, новий сетап). Ліміт збитку за день (−3R) рахує закриті позиції, відкритий ризик сумується.")
sameDir   = input.bool(true, "Додаткові позиції лише в той самий бік, що й відкриті", group=g1)
wkLimit   = input.float(-6.0, "Тижнева межа збитку, R", group=g1)
friCut    = input.float(16.0, "П'ятниця: нових входів не після (година UTC)", step=0.5, minval=0.0, maxval=24.0, group=g1)
chainOn   = input.bool(false, "Ланцюг після цілі: зворотна угода ≤40 хв (правило #40/#58)", group=g1, tooltip="Після досягнення цілі рівень працює в інший бік: протягом 8 барів M5 дозволено сетап у зворотний бік навіть проти біасу. За бектестом 08–10.2026 різниці майже немає (на 2 угоди більше, середній результат трохи нижчий), тому вимкнено за замовчуванням.")

// ═════════════ 2 · УМОВИ ВХОДУ ═════════════
g2 = "2 · Умови входу (зняття пулу + реклейм)"
sweepIn  = input.float(2.0, "Мін. прокол рівня для зняття, пунктів", step=0.5, minval=0.0, group=g2, tooltip="Правило #25: прокол 2–3 п з поверненням = зняття. За бектестом 08–10.2026 мінімальний прокол 2–3 п дав кращий результат, ніж 0.3 п (+0.67…+0.72R проти +0.47R), далі від 4 п результат падає. Для індексів — пункти.")
maxAge   = input.int(3, "Скільки барів після зняття чекати реклейм", minval=0, group=g2)
minBody  = input.float(0.3, "Мін. тіло реклейм-бару, ×ATR", step=0.05, group=g2)
entryFx  = input.float(15.0, "Макс. відстань входу від екстремуму зняття, пунктів (форекс)", step=1.0, group=g2)
entryAtr = input.float(2.7, "Макс. відстань входу від екстремуму зняття, ×ATR (індекси)", step=0.1, group=g2)
atrLen   = input.int(24, "Довжина ATR (барів M5)", minval=2, group=g2)
entryMode = input.string("Лімітка на відкритті реклейм-бару", "Тип входу", options=["Лімітка на відкритті реклейм-бару", "Лімітка на Open OB (свічка перед імпульсом)", "Ринком на закритті"], group=g2, tooltip="Лімітка: чекаємо ретест відкриття реклейм-бару (вхід кращий, але угода не завжди заповнюється). Ринком: вхід одразу на закритті реклейм-бару. За бектестом лімітка давала приблизно +0.15…0.2R на угоду більше, ніж ринок.")
fvgOn    = input.bool(true, "FVG-ліміт ноги зняття (M15): ліміт на краю FVG після зняття", group=g2, tooltip="Після зняття максимуму/мінімуму ціна рухається імпульсом і лишає FVG на M15. Ліміт ставиться на ближній край цього FVG, стоп за екстремумом зняття, ціль найближчий пул з RR від мінімуму. Це сетап власника (07:15 UTC 09.10: шорт 1.12323, SL 1.12428). За бектестом 08–10.2026 він додає угоди зі слабким результатом, тож це опція, а не обіцянка прибутку.")
fvgBase  = input.bool(true, "FVG-ліміт: дозволено ставити з початку сесії (до вікна входу); заповнення лише у вікні", group=g2, tooltip="Ранковий FVG з'являється ще до 07:00 UTC, а ліміт на нього заповнюється пізніше. Вимкнено: ліміт можна ставити лише всередині вікон входу. За бектестом 08–10.2026 дозвіл ставити раніше додає угоди зі слабким результатом.")
fvgMin   = input.float(1.5, "FVG-ліміт: мін. розмір FVG, пунктів", step=0.5, group=g2)
fvgBuf   = input.float(1.0, "FVG-ліміт: буфер стопа за екстремумом, пунктів", step=0.5, group=g2)
fvgRiskAtr = input.float(8.0, "FVG-ліміт: макс. ризик, ×ATR(M5)", step=0.5, group=g2)
fvgExp   = input.int(96, "FVG-ліміт: скільки барів M5 чекати заповнення (96 = 8 годин)", minval=6, group=g2)
pendBars = input.int(6, "Скільки барів чекати заповнення лімітки", minval=1, group=g2)

// ═════════════ 3 · СТОП, РИЗИК І ЦІЛЬ ═════════════
g3 = "3 · Стоп, ризик і ціль"
bufMult  = input.float(1.0, "Буфер стопа за екстремумом зняття, ×ATR", step=0.05, group=g3)
minStopP = input.float(2.0, "Мін. відстань стопа, пунктів (форекс)", step=0.5, group=g3)
riskMinA = input.float(0.8, "Мін. ризик угоди, ×ATR", step=0.1, group=g3)
riskMaxA = input.float(3.0, "Макс. ризик угоди, ×ATR", step=0.1, group=g3)
rrMin    = input.float(2.25, "Мін. співвідношення ризик/прибуток (RR)", step=0.05, group=g3)
protOn   = input.bool(false, "Страховка: переносити стоп, коли структура змінилась проти позиції (Shift)", group=g3, tooltip="УВАГА: суперечить правилу «стоп не рухається» (ADR 08.10.2026), тому вимкнено за замовчуванням. Коли позиція вже пройшла потрібну частину шляху до цілі, а на поточному ТФ підтверджено Shift проти позиції (закриття за останнім свінгом), стоп переноситься, і приходить сповіщення. За бектестом 08–10.2026 спрацьовує рідко (6 з 63 угод) і не змінює результат.")
protMinR = input.float(1.0, "Страховка: мін. пройдений прибуток до переносу, R", step=0.25, minval=0.0, group=g3)
protLock = input.float(0.0, "Страховка: куди переносити стоп, R від входу (0 = на вхід, 0.5 = фіксувати +0.5R)", step=0.25, minval=0.0, maxval=3.0, group=g3)

// ═════════════ 4 · ЩО МАЛЮВАТИ ═════════════
g4 = "4 · Що малювати на графіку"
showLvls = input.bool(true, "Рівні ліквідності (PDH/PDL, азія, свінги…)", group=g4)
showFvg  = input.bool(true, "FVG — гепи справедливої вартості", group=g4)
showOb   = input.bool(true, "OB — ордер-блоки", group=g4)
showH1   = input.bool(true, "Таймфрейм H1", group=g4, inline="t")
showH4   = input.bool(true, "H4", group=g4, inline="t")
showD    = input.bool(true, "D (денний)", group=g4, inline="t")
showSessLines = input.bool(true, "Лінії PDC і Daily Open", group=g4)
dailyMode = input.string("Свічка D (17:00 Нью-Йорк)", "Daily Open — звідки брати", options=["Свічка D (17:00 Нью-Йорк)", "00:00 Нью-Йорк (midnight open)"], group=g4, tooltip="Свічка D: відкриття денної свічки (17:00 Нью-Йорк = 00:00 за Києвом влітку). Друга опція: відкриття о 00:00 Нью-Йорк — це вже New York Open.")
showPD   = input.bool(true, "Prev Day High / Low (PDH, PDL)", group=g4)
showWeek = input.bool(true, "Weekly Open, Prev Week High / Low (PWH, PWL)", group=g4)
showNyO  = input.bool(true, "New York Open", group=g4, inline="ny")
nyH      = input.float(0.0, "час за Нью-Йорком (0 = 00:00 = 07:00 за Києвом влітку, 08:00 взимку з поправкою)", step=0.5, group=g4, inline="ny")
showPW   = input.bool(true, "PWH / PWL як пули ліквідності (цілі й стопи, правило #49)", group=g4)
showDead = input.bool(false, "Показувати зняті рівні та зламані зони (сірі, зі словами «знято», INV, MIT)", group=g4, tooltip="Вимкнено: щойно рівень знято, його лінія й підпис зникають; зламана FVG чи OB зникає. Знятий рівень усе одно враховується в логіці сетапу.")
showPool = input.bool(true, "Виділяти пули ліквідності (рівні свінги EQH / EQL, ×2 і більше)", group=g4, tooltip="Пул ліквідності — кілька однакових максимумів (BSL, стопи покупців зверху) чи мінімумів (SSL, стопи продавців знизу) на одній ціні. Такі рівні малюються товстою лінією і плашкою «ПУЛ»; зняття пулу — основа сетапу.")
showScen = input.bool(true, "Планові лімітки-сценарії: де ціна може дійти, відштовхнутись і піти", group=g4, tooltip="Попередньо малює можливу лімітку: найближча зона (FVG/OB) або пул ліквідності проти ціни в бік біасу, стоп за далеким краєм, ціль на найближчий пул з потрібним RR, обсяг лота. Це сценарій, а не сигнал: ордера немає, доки ціна не дійде. Зникає, коли ціна пройшла зону.")
scenMaxAtr = input.float(1.5, "Сценарії: макс. відстань до входу, ×ATR(D)", step=0.25, minval=0.25, group=g4)
showNear = input.bool(true, "Найближчі підтримка й опір (завжди виділені)", group=g4)
maxLv    = input.int(70, "Макс. рівнів на графіку", minval=10, maxval=200, group=g4)
maxZn    = input.int(150, "Макс. зон на графіку", minval=10, maxval=200, group=g4)
zoneBand = input.float(4.0, "Малювати зони лише в межах ×ATR(D) від ціни", step=0.5, group=g4)
dispMult = input.float(1.5, "OB: сила зсуву (тіло свічки ≥ ×середній діапазон)", step=0.1, group=g4)

// ═════════════ 5 · ВИГЛЯД ═════════════
g5 = "5 · Вигляд і кольори"
colBsl   = input.color(color.new(#ef5350, 0), "Колір: ліквідність зверху (BSL)", group=g5, inline="c1")
colSsl   = input.color(color.new(#26a69a, 0), "знизу (SSL)", group=g5, inline="c1")
colD     = input.color(color.new(#ab47bc, 0), "Колір зон: D", group=g5, inline="c2")
colH4    = input.color(color.new(#ff9800, 0), "H4", group=g5, inline="c2")
colH1    = input.color(color.new(#42a5f5, 0), "H1", group=g5, inline="c2")
colRes   = input.color(color.new(#ff5252, 0), "Колір: найближчий опір", group=g5, inline="c4")
colSup   = input.color(color.new(#00e676, 0), "найближча підтримка", group=g5, inline="c4")
colRisk  = input.color(color.new(#ef5350, 0), "Колір угоди: ризик", group=g5, inline="c3")
colRew   = input.color(color.new(#26a69a, 0), "ціль", group=g5, inline="c3")
colPend  = input.color(color.new(#ff9800, 0), "Колір лімітки (очікує заповнення)", group=g5)
colScRisk = input.color(color.new(#8e24aa, 0), "Колір сценарію: ризик", group=g5, inline="sc")
colScRew  = input.color(color.new(#5c6bc0, 0), "ціль", group=g5, inline="sc")
scFade   = input.int(78, "Сценарій: прозорість боксів, % (більше = блідіше)", minval=50, maxval=96, group=g5)
colPDC   = input.color(color.new(#2962ff, 35), "Колір ключових рівнів: PDC", group=g5, inline="k0")
colDO    = input.color(color.new(#2979ff, 5), "Daily Open", group=g5, inline="k0")
colNY    = input.color(color.new(#e040fb, 5), "New York Open", group=g5, inline="k0")
colWO    = input.color(color.new(#ffb300, 5), "Weekly Open", group=g5, inline="k1")
colPDH   = input.color(color.new(#ef5350, 5), "Prev Day High", group=g5, inline="k1")
colPDL   = input.color(color.new(#26a69a, 5), "Prev Day Low", group=g5, inline="k1")
colPWH   = input.color(color.new(#ff7043, 5), "Prev Week High", group=g5, inline="k2")
colPWL   = input.color(color.new(#26c6da, 5), "Prev Week Low", group=g5, inline="k2")
zoneTr   = input.int(86, "Прозорість зон, % (більше = прозоріше)", minval=50, maxval=98, group=g5)
boxTr    = input.int(80, "Прозорість боксів угоди, %", minval=50, maxval=98, group=g5)
lblSizeIn = input.string("Малий", "Розмір підписів", options=["Дрібний", "Малий", "Звичайний"], group=g5)
keySizeIn = input.string("Звичайний", "Розмір підписів ключових рівнів (Daily/Weekly/NY Open…)", options=["Малий", "Звичайний", "Великий"], group=g5)
tableMode = input.string("Компактна", "Таблиця стану", options=["Компактна", "Повна", "Вимкнена"], group=g5, tooltip="Компактна: 5 рядків дрібним шрифтом (для телефона й малих екранів). Повна: усі показники. Вимкнена: таблиці немає.")
tablePosIn = input.string("Вгорі зліва", "Де розташувати таблицю", options=["Вгорі зліва", "Вгорі справа", "Внизу зліва", "Внизу справа"], group=g5)
showTable = tableMode != "Вимкнена"
tblPos = tablePosIn == "Вгорі справа" ? position.top_right : tablePosIn == "Внизу зліва" ? position.bottom_left : tablePosIn == "Внизу справа" ? position.bottom_right : position.top_left

// ═════════════ 6 · ІСТОРІЯ УГОД ═════════════
g6 = "6 · Історія угод"
showPos  = input.bool(true, "Показувати позиції (бокси, лінії, мітки)", group=g6, tooltip="Вимкнено: позиції лише рахуються (таблиця, статистика), але на графіку не малюються.")
showLim  = input.bool(true, "Показувати лімітки (очікують входу, скасовані, сценарні)", group=g6, tooltip="Вимкнено: лімітки не малюються (сценарії теж). Коли лімітка спрацьовує, вона стає позицією і малюється за перемикачем позицій.")
histN    = input.int(5, "Скільки останніх позицій показувати на графіку", minval=1, maxval=50, group=g6, tooltip="Рахуються закриті позиції (основні й сценарні разом). Старіші видаляються з графіка. Відкрита позиція показується завжди.")
histLim  = input.int(3, "Скільки останніх ліміток показувати на графіку", minval=0, maxval=50, group=g6, tooltip="Рахуються активні й нещодавно скасовані лімітки (скасована лишається сірою з написом «не спрацювала»). Старіші скасовані видаляються. 0: скасовані лімітки одразу зникають, активні показуються завжди.")
minPosBars = input.int(10, "Мін. ширина позиції, барів (якщо стоп не спрацював)", minval=1, maxval=100, group=g6, tooltip="Позиція, яка не закрилась стопом (відкрита, по цілі або по часу), малюється не вужче за цю кількість барів від входу.")
minStopBars = input.int(3, "Мін. ширина позиції, що закрилась по стопу, барів", minval=1, maxval=100, group=g6)

// ═════════════ 7 · РАХУНОК І РОЗМІР ПОЗИЦІЇ ═════════════
g8 = "7 · Рахунок і розмір позиції"
showLot  = input.bool(true, "Показувати обсяг (лоти) на позиції", group=g8)
lotSizeIn = input.string("Звичайний", "Розмір плашки з лотами", options=["Дрібний", "Малий", "Звичайний", "Великий", "Величезний"], group=g8)
accSize  = input.float(10000.0, "Розмір рахунку, $", minval=0.0, step=100.0, group=g8)
riskPct  = input.float(1.0, "Ризик на угоду, % від рахунку", minval=0.0, step=0.1, group=g8)
riskUsdIn = input.float(0.0, "…або фіксований ризик на угоду, $ (0 = рахувати за %)", minval=0.0, step=10.0, group=g8)
fxPipVal = input.float(10.0, "Форекс: вартість 1 пункту (0.0001) за 1 лот, $", minval=0.0, step=0.5, group=g8, tooltip="EURUSD, GBPUSD та інші пари з USD в котируванні: 10$. Для JPY, CHF, CAD пар вкажи свою.")
idxPtVal = input.float(1.0, "Індекси: вартість 1 пункту за 1 лот, $", minval=0.0, step=0.1, group=g8, tooltip="GER40 у брокера: перевір специфікацію контракту (зазвичай 1 пункт = 1 одиниця валюти рахунку на 1 лот).")
lotStep  = input.float(0.01, "Крок лоту (мінімальний обсяг)", minval=0.0001, step=0.01, group=g8)

// ═════════════ 8 · СТРУКТУРА РИНКУ (поточний таймфрейм) ═════════════
g9 = "8 · Структура ринку (поточний ТФ)"
showStruct = input.bool(true, "BOS і Shift (злам структури / зсув)", group=g9, tooltip="BOS — злам останнього свінгу за напрямом тренду (продовження). Shift — злам свінгу проти тренду (зміна характеру, CHoCH/MSS). Працює на тому таймфреймі, який відкритий на графіку.")
showRange = input.bool(true, "Позначати боковик / акумуляцію (діапазон)", group=g9)
showAmd  = input.bool(true, "AMD: Accumulation (Азія) → Manipulation → Distribution", group=g9, tooltip="A — діапазон азійської сесії (22:00–06:00 UTC), коли ринок накопичує. M — зняття максимуму або мінімуму Азії у вікні 06:00–14:00 UTC (маніпуляція, Judas swing). D — закриття за протилежним краєм Азії: розподіл, рух у бік, протилежний до зняття.")
accEnd   = input.float(5.0, "Акумуляція Азії: до якої години UTC (передранковий спайк не входить)", step=0.5, minval=2.0, maxval=8.0, group=g9)
accMinAtr = input.float(2.0, "Акумуляція: мін. висота, ×ATR(M5)", step=0.5, group=g9)
accMaxAtr = input.float(10.0, "Акумуляція: макс. висота, ×ATR(M5)", step=0.5, group=g9)
amNetMax = input.float(0.35, "Акумуляція Азії: макс. чистий рух за сесію, частка діапазону", step=0.1, minval=0.1, maxval=1.0, group=g9, tooltip="Якщо Азія пройшла тренд (закриття далеко від відкриття, більше цієї частки діапазону), це не акумуляція, і бокс A не малюється.")
colAcc   = input.color(color.new(#4dd0e1, 0), "Колір акумуляції (A)", group=g9, inline="a1")
colMan   = input.color(color.new(#ffa726, 0), "маніпуляції (M)", group=g9, inline="a1")
colDis   = input.color(color.new(#66bb6a, 0), "розподілу (D)", group=g9, inline="a1")
showShiftLvl = input.bool(true, "Показувати, де буде найближчий Shift і BOS (рівні-тригери)", group=g9, tooltip="Shift ▲/▼ — рівень, за який ціні треба закритися, щоб структура змінила напрям. BOS — рівень продовження тренду. Рівні беруться з останніх свінгів.")
swLen    = input.int(5, "Довжина свінгу (барів з кожного боку)", minval=2, maxval=20, group=g9)
maxMarks = input.int(20, "Скільки останніх міток BOS/Shift тримати на графіку", minval=5, maxval=100, group=g9)
showSwings = input.bool(true, "Позначати свінги (SH/SL) і від якого свінга пішов BOS/Shift", group=g9, tooltip="SH — свінг-хай, SL — свінг-лоу (довжина задається нижче). Коли ціна ламає свінг, його мітка перефарбовується в колір BOS або Shift і дописується, який саме злам це був. У мітці BOS/Shift вказано ціну і час свінга, від якого пішов злам. Рівні-тригери теж підписані часом свінга.")
maxSwings = input.int(30, "Скільки останніх свінгів тримати на графіку", minval=5, maxval=100, group=g9)
colSwH   = input.color(color.new(#00c853, 0), "Колір свінг-хая (SH)", group=g9, inline="s2")
colSwL   = input.color(color.new(#ff1744, 0), "свінг-лоу (SL)", group=g9, inline="s2")
rngLen   = input.int(36, "Боковик: вікно пошуку, барів", minval=10, maxval=200, group=g9)
rngMaxAtr = input.float(4.0, "Боковик: макс. висота діапазону, ×ATR", step=0.5, group=g9)
adxMax   = input.float(22.0, "Боковик: ADX нижче за", step=1.0, group=g9)
colBos   = input.color(color.new(#26a69a, 0), "Колір BOS", group=g9, inline="s1")
colShift = input.color(color.new(#ffb300, 0), "Shift", group=g9, inline="s1")
colRng   = input.color(color.new(#b0bec5, 0), "Боковик", group=g9, inline="s1")

// ═════════════ 9 · АЛЕРТИ ═════════════
g7 = "9 · Алерти"
hookSecret = input.string("", "Секрет вебхука (передається в повідомленні алерта, перевіряється приймачем n8n)", group=g7)

// ───────────── Інструмент і масштаб
isFx    = syminfo.type == "forex"
isJpy   = str.contains(syminfo.ticker, "JPY")
pip     = isFx ? (isJpy ? 0.01 : 0.0001) : 1.0
unitTxt = isFx ? " п" : " пт"
sweepMin = sweepIn * pip
zoneTol  = (isFx ? 0.3 : 1.0) * pip
clusTol  = (isFx ? 1.0 : 3.0) * pip
minStop  = isFx ? minStopP * pip : 0.0
fvgScl   = isFx ? 1.0 : 3.0
atrV     = ta.atr(atrLen)
atrD     = request.security(syminfo.tickerid, "D", ta.atr(14)[1], lookahead = barmerge.lookahead_on)
[pdHD, pdLD] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_on)
[wkO, pwH, pwL] = request.security(syminfo.tickerid, "W", [open, high[1], low[1]], lookahead = barmerge.lookahead_on)
[dcl1, dcl4] = request.security(syminfo.tickerid, "D", [close[1], close[4]], lookahead = barmerge.lookahead_on)
htfTr    = dcl1 > dcl4 ? 1 : dcl1 < dcl4 ? -1 : 0

sessFrom = sessFromH * 60 + sessFromM
sessTo   = sessToH * 60 + sessToM
minOfDay = hour(time, "UTC") * 60 + minute(time, "UTC")
newDay   = dayofweek(time, "UTC") != dayofweek(time[1], "UTC")
newWeek  = weekofyear(time, "UTC") != weekofyear(time[1], "UTC")
inSess   = minOfDay >= sessFrom and minOfDay < sessTo
kzOk     = kzMode == "Весь торговий час" or (minOfDay >= kz1a * 60 and minOfDay < kz1b * 60) or (minOfDay >= kz2a * 60 and minOfDay < kz2b * 60)
tradeWin = inSess and kzOk
lblSize  = lblSizeIn == "Дрібний" ? size.tiny : lblSizeIn == "Звичайний" ? size.normal : size.small
lotSz = lotSizeIn == "Дрібний" ? size.tiny : lotSizeIn == "Малий" ? size.small : lotSizeIn == "Звичайний" ? size.normal : lotSizeIn == "Великий" ? size.large : size.huge

// ───────────── Типи
type Lvl
    float  p
    float  lo
    float  hi
    bool   isHigh
    int    n
    bool   swept
    bool   done
    int    born
    int    sweepBar
    float  ext
    string tag
    line   ln
    label  lb

type Zn
    box    bx
    bool   bull
    bool   isFvg
    bool   dead
    float  top
    float  bot
    string tf

type Trd
    box    rb
    box    wb
    line   el
    label  lb
    label  xl
    int    side
    float  entry
    float  sl
    float  tp
    float  r
    bool   open
    bool   sh
    bool   late
    int    xbar
    label  tl
    label  lotl
    label  whyl
    label  tpl
    line   tln
    int    st
    int    b0
    int    exp
    bool   fv
    float  inv
    float  lotv
    float  ruv
    string sTx
    string bTx
    string wTx
    float  r0
    float  mfe
    bool   mv
    line   mln
    bool   sc
    box    pg1
    box    pg2
    float  mxF
    float  mxA

var array<Lvl> lv = array.new<Lvl>()
var array<Zn>  zn = array.new<Zn>()
var array<Trd> trades = array.new<Trd>()
cntAct() =>
    int c = 0
    int n = trades.size()
    if n > 0
        for i = 0 to n - 1
            Trd t = trades.get(i)
            if t.open and not t.sc
                c += 1
    c
cntActSc() =>
    int c = 0
    int n = trades.size()
    if n > 0
        for i = 0 to n - 1
            Trd t = trades.get(i)
            if t.open and t.sc
                c += 1
    c
sideOkFn(int sd) =>
    bool ok = true
    int n = trades.size()
    if sameDir and n > 0
        for i = 0 to n - 1
            Trd t = trades.get(i)
            if t.open and not t.sc and t.side != sd
                ok := false
    ok

// ───────────── Рівні
lblText(Lvl l) =>
    (l.isHigh ? "▲ BSL " : "▼ SSL ") + (l.n > 1 and showPool ? "ПУЛ " : "") + l.tag + (l.n > 1 ? " ×" + str.tostring(l.n) : "") + "  " + str.tostring(l.p, format.mintick)

tfName(string tf) => tf == "D" ? "Daily" : tf
lvName(string tag) => tag == "PDH" ? "вчорашній максимум (PDH)" : tag == "PDL" ? "вчорашній мінімум (PDL)" : tag == "PWH" ? "максимум минулого тижня (PWH)" : tag == "PWL" ? "мінімум минулого тижня (PWL)" : tag == "ASIA H" ? "максимум азії" : tag == "ASIA L" ? "мінімум азії" : tag == "DAY" ? "екстремум дня" : tag == "H1" ? "свінг H1" : tag == "D" ? "свінг Daily" : tag
zoneAt(float px) =>
    string r = ""
    float bestD = 1e10
    int nz0 = zn.size()
    if nz0 > 0
        for i = 0 to nz0 - 1
            Zn z = zn.get(i)
            if not z.dead
                float d = px > z.top ? px - z.top : px < z.bot ? z.bot - px : 0.0
                if d <= 3.0 * pip and d < bestD
                    bestD := d
                    r := tfName(z.tf) + (z.isFvg ? " FVG " : " OB ") + (z.bull ? "▲" : "▼") + " " + str.tostring(z.bot, format.mintick) + "–" + str.tostring(z.top, format.mintick)
    r
biasWord(int b) => b == -1 ? "ВНИЗ" : b == 1 ? "ВГОРУ" : "обидва боки"
biasMode() => biasIn == "Тренд D (3 дні)" ? "тренд D" : biasIn == "Азія + тренд D" ? "азія + D" : biasIn == "Авто (за азією)" ? "азія" : "ручний"
tpWhy(Lvl q) => (q.isHigh ? "BSL" : "SSL") + " · " + lvName(q.tag) + (q.n > 1 ? " ×" + str.tostring(q.n) : "") + " — пул ліквідності, куди ціна тягнеться"

var array<float> scUsed = array.new<float>()
scenFor(int dirn) =>
    bool ok = false
    float bestDist = 1e10
    float eP = na
    float fE = na
    string oTxt = ""
    float sSl = na
    float sTp = na
    string tpTxt = ""
    float sRisk = na
    int nzs = zn.size()
    if nzs > 0
        for i = 0 to nzs - 1
            Zn z = zn.get(i)
            if not z.dead
                float d = dirn == -1 ? z.bot - close : close - z.top
                if (dirn == -1 and not z.bull) or (dirn == 1 and z.bull)
                    if d > 0 and d < bestDist
                        bestDist := d
                        eP := dirn == -1 ? z.bot : z.top
                        fE := dirn == -1 ? z.top : z.bot
                        oTxt := tfName(z.tf) + (z.isFvg ? " FVG " : " OB ") + (z.bull ? "▲ " : "▼ ") + str.tostring(z.bot, format.mintick) + "–" + str.tostring(z.top, format.mintick)
    int nls = lv.size()
    if nls > 0
        for i = 0 to nls - 1
            Lvl q = lv.get(i)
            if not q.swept and q.isHigh == (dirn == -1)
                float d = dirn == -1 ? q.lo - close : close - q.hi
                if d > 0 and d < bestDist
                    bestDist := d
                    eP := dirn == -1 ? q.lo : q.hi
                    fE := dirn == -1 ? q.hi : q.lo
                    oTxt := (q.isHigh ? "BSL " : "SSL ") + lvName(q.tag) + (q.n > 1 ? " ×" + str.tostring(q.n) : "") + " " + str.tostring(q.p, format.mintick) + " (знімання пулу)"
    bool used = false
    int nu = scUsed.size()
    if nu > 0 and not na(eP)
        for i = 0 to nu - 1
            if math.abs(scUsed.get(i) - eP) <= 1.0 * pip
                used := true
    if not na(eP) and not used and bestDist <= scenMaxAtr * atrD
        float sBuf = math.max(bufMult * atrV, minStop)
        sSl := dirn == -1 ? math.max(fE, eP) + sBuf : math.min(fE, eP) - sBuf
        sRisk := math.abs(sSl - eP)
        if sRisk >= riskMinA * atrV and sRisk <= fvgRiskAtr * atrV and sRisk >= minStop
            float sBest = 1e10
            int nq2 = lv.size()
            if nq2 > 0
                for j = 0 to nq2 - 1
                    Lvl q2 = lv.get(j)
                    if not q2.swept and q2.isHigh == (dirn == 1)
                        float px2 = dirn == -1 ? q2.hi : q2.lo
                        float dist2 = dirn == -1 ? eP - px2 : px2 - eP
                        if dist2 > 0 and dist2 / sRisk >= rrMin and dist2 < sBest
                            sBest := dist2
                            sTp := px2
                            tpTxt := tpWhy(q2)
            ok := not na(sTp)
    [ok, eP, sSl, sTp, bestDist, oTxt, tpTxt, sRisk]

dropLvl(int i) =>
    Lvl o = lv.get(i)
    line.delete(o.ln)
    label.delete(o.lb)
    lv.remove(i)

addLevel(float price, bool isHigh, string tag) =>
    bool merged = false
    int sz = lv.size()
    if sz > 0
        for i = 0 to sz - 1
            Lvl l = lv.get(i)
            if not l.swept and l.isHigh == isHigh and math.abs(l.p - price) <= clusTol
                l.n += 1
                l.lo := math.min(l.lo, price)
                l.hi := math.max(l.hi, price)
                l.p := (l.lo + l.hi) / 2
                line.set_y1(l.ln, l.p)
                line.set_y2(l.ln, l.p)
                label.set_y(l.lb, l.p)
                label.set_text(l.lb, lblText(l))
                if showPool and l.n >= 2
                    color pc = isHigh ? colBsl : colSsl
                    line.set_width(l.ln, 3)
                    line.set_color(l.ln, color.new(pc, 0))
                    line.set_style(l.ln, line.style_solid)
                    label.set_style(l.lb, label.style_label_left)
                    label.set_color(l.lb, color.new(pc, 15))
                    label.set_textcolor(l.lb, isHigh ? color.white : color.black)
                merged := true
                break
    if not merged
        color c = isHigh ? colBsl : colSsl
        bool sessTag = tag == "PDH" or tag == "PDL" or tag == "ASIA H" or tag == "ASIA L" or tag == "DAY"
        line ln = line.new(bar_index, price, bar_index + 1, price, extend = extend.right, color = color.new(c, 25), style = sessTag ? line.style_dotted : line.style_dashed, width = tag == "D" ? 2 : 1)
        Lvl nl = Lvl.new(price, price, price, isHigh, 1, false, false, bar_index, na, na, tag, ln, na)
        nl.lb := label.new(bar_index, price, lblText(nl), style = label.style_none, textcolor = color.new(c, 10), size = lblSize)
        lv.push(nl)
        if lv.size() > maxLv
            dropLvl(0)

// ───────────── Стан дня / азії
var float dayH = na
var float dayL = na
var float dayO = na
var float pdh  = na
var float pdl  = na
var float pdc  = na
var float ldnO = na
var float nyO  = na
var float dOpenNY = na
var float asCurH = na
var float asCurL = na
var int   asCurHt = na
var int   asCurLt = na
var float asH = na
var float asL = na
var int   asHt = na
var int   asLt = na
var int   biasAuto = 0
var float dayR = 0.0
var float wkR = 0.0
var float wkHi = na
var float wkLo = na
var int   chainUntil = -1
var int   chainSide = 0
var float lastR = na

inAsia  = hour(time, "UTC") >= 22 or hour(time, "UTC") < 6
asStart = inAsia and not inAsia[1]
asEnd   = (not inAsia) and inAsia[1]

// ───────────── Дані старших ТФ (без перемальовування: закрита свічка HTF)
htf(simple string tf) =>
    request.security(syminfo.tickerid, tf, [time[1], time[3], time[4], time[5], open[1], high[1], low[1], close[1], open[2], high[2], low[2], close[2], open[3], high[3], low[3], close[3], open[4], high[4], low[4], close[4], open[5], high[5], low[5], close[5], ta.sma(high - low, 60)[1]], lookahead = barmerge.lookahead_on)

[tH1, tH1a, tH1b, tH1c, oH1_1, hH1_1, lH1_1, cH1_1, oH1_2, hH1_2, lH1_2, cH1_2, oH1_3, hH1_3, lH1_3, cH1_3, oH1_4, hH1_4, lH1_4, cH1_4, oH1_5, hH1_5, lH1_5, cH1_5, avH1] = htf("60")
[tH4, tH4a, tH4b, tH4c, oH4_1, hH4_1, lH4_1, cH4_1, oH4_2, hH4_2, lH4_2, cH4_2, oH4_3, hH4_3, lH4_3, cH4_3, oH4_4, hH4_4, lH4_4, cH4_4, oH4_5, hH4_5, lH4_5, cH4_5, avH4] = htf("240")
[tD1, tD1a, tD1b, tD1c, oD_1, hD_1, lD_1, cD_1, oD_2, hD_2, lD_2, cD_2, oD_3, hD_3, lD_3, cD_3, oD_4, hD_4, lD_4, cD_4, oD_5, hD_5, lD_5, cD_5, avD] = htf("D")

[phH1, plH1, ptH1] = request.security(syminfo.tickerid, "60", [ta.pivothigh(high, 2, 2)[1], ta.pivotlow(low, 2, 2)[1], time[3]], lookahead = barmerge.lookahead_on)
[phD, plD, ptD]    = request.security(syminfo.tickerid, "D", [ta.pivothigh(high, 2, 2)[1], ta.pivotlow(low, 2, 2)[1], time[3]], lookahead = barmerge.lookahead_on)

// ───────────── Зони (FVG + OB)
newZone(string tf, bool bull, bool isFvg, int tLeft, float bot, float top) =>
    color c = tf == "D" ? colD : tf == "H4" ? colH4 : colH1
    color fillC = isFvg ? color.new(c, zoneTr) : color.new(bull ? colSsl : colBsl, zoneTr)
    color brd = isFvg ? color.new(c, 55) : color.new(bull ? colSsl : colBsl, 55)
    box bx = box.new(tLeft, top, time, bot, xloc = xloc.bar_time, extend = extend.right, border_color = brd, border_width = 1, bgcolor = fillC, text = tf + (isFvg ? " FVG " : " OB ") + (bull ? "▲" : "▼"), text_color = color.new(c, 15), text_size = lblSize, text_halign = text.align_right)
    zn.push(Zn.new(bx, bull, isFvg, false, top, bot, tf))
    if zn.size() > maxZn
        Zn o = zn.get(0)
        box.delete(o.bx)
        zn.remove(0)

procHtf(string tf, bool on, float minFvg, int t1, int t1prev, int t3, int t4, int t5, float o1, float h1, float l1, float c1, float o2, float h2, float l2, float c2, float o3, float h3, float l3, float c3, float o4, float h4, float l4, float c4, float o5, float h5, float l5, float c5, float av) =>
    if on and not na(t1) and t1 != t1prev and not na(atrD)
        bool inBand = math.abs(close - (h2 + l2) / 2) <= zoneBand * atrD
        if showFvg and inBand
            if l1 > h3 and (l1 - h3) >= minFvg
                newZone(tf, true, true, t3, h3, l1)
            if h1 < l3 and (l3 - h1) >= minFvg
                newZone(tf, false, true, t3, h1, l3)
        if showOb and inBand and av > 0
            float body2 = math.abs(c2 - o2)
            if body2 >= dispMult * av
                if c2 > o2 and l1 > h3
                    if o3 > c3
                        newZone(tf, true, false, t3, l3, h3)
                    else if o4 > c4
                        newZone(tf, true, false, t4, l4, h4)
                    else if o5 > c5
                        newZone(tf, true, false, t5, l5, h5)
                if c2 < o2 and h1 < l3
                    if o3 < c3
                        newZone(tf, false, false, t3, l3, h3)
                    else if o4 < c4
                        newZone(tf, false, false, t4, l4, h4)
                    else if o5 < c5
                        newZone(tf, false, false, t5, l5, h5)

updateZones() =>
    int sz = zn.size()
    if sz > 0
        for i = 0 to sz - 1
            Zn z = zn.get(i)
            if not z.dead
                if z.bull
                    if close < z.bot - zoneTol
                        z.dead := true
                    else if z.isFvg and low < z.top
                        z.top := math.max(low, z.bot)
                        box.set_top(z.bx, z.top)
                else
                    if close > z.top + zoneTol
                        z.dead := true
                    else if z.isFvg and high > z.bot
                        z.bot := math.min(high, z.top)
                        box.set_bottom(z.bx, z.bot)
                if z.dead
                    if showDead
                        box.set_bgcolor(z.bx, color.new(color.gray, 93))
                        box.set_border_color(z.bx, color.new(color.gray, 75))
                        box.set_text(z.bx, (z.isFvg ? "INV " : "MIT ") + z.tf + (z.isFvg ? " FVG" : " OB"))
                        box.set_text_color(z.bx, color.new(color.gray, 30))
                        box.set_extend(z.bx, extend.none)
                        box.set_right(z.bx, time)
                    else
                        box.delete(z.bx)

// ───────────── Стан поточної угоди
var int    shiftBar = na
var int    shiftDir = 0
var array<float>  scEn = array.new<float>(2, na)
var array<float>  scSl = array.new<float>(2, na)
var array<float>  scTp = array.new<float>(2, na)
var array<int>    scBr = array.new<int>(2, 0)
var array<string> scOr = array.new<string>(2, "")
var array<string> scTt = array.new<string>(2, "")
var array<float>  scDs = array.new<float>(2, na)
var int    cntO   = 0
var int    cntP   = 0
var bool   tOn    = false
var int    tSide  = 0
var float  tEntry = na
var float  tSl    = na
var float  tTp    = na
var int    tBar   = na
var int    tNSig  = 0
var bool   pFvg   = false
var float  pInval = na
var string swHTag = ""
var string swLTag = ""
var int    swHBar = na
var float  swHMax = na
var int    swLBar = na
var float  swLMin = na
var float  cO = na
var float  cH = na
var float  cL = na
var float  cC = na
var float  o1 = na
var float  h1 = na
var float  l1 = na
var float  c1 = na
var float  o2 = na
var float  h2 = na
var float  l2 = na
var float  c2 = na
var bool   pOn    = false
var int    pBar   = na
var int    pExp   = na
var int    pSide  = 0
var float  pEntry = na
var float  pSl    = na
var float  pTp    = na
var int    curBias = 0
var float  tLot   = na
var float  tRiskUsd = na

fmt(float v) => str.tostring(v, format.mintick)
visK(bool lim, color c) => (lim ? showLim : showPos) ? c : color.new(c, 100)
sgn(float v) => (v >= 0 ? "+" : "") + str.tostring(v, "0.00")

jq(string t) => str.replace_all(str.replace_all(t, "\"", "'"), "\n", " ")
sendHook(string j) => alert(j, alert.freq_all)
hookFill(string sd, float en, float sl, float tp, float lt, float usd, string st, string bt, string wy) => '{"k":"' + hookSecret + '","ev":"fill","sym":"' + syminfo.ticker + '","side":"' + sd + '","entry":"' + fmt(en) + '","sl":"' + fmt(sl) + '","tp":"' + fmt(tp) + '","rr":"' + str.tostring(math.abs(tp - en) / math.abs(en - sl), "0.0") + '","risk":"' + str.tostring(math.abs(en - sl) / pip, "0.0") + unitTxt + '","lot":"' + str.tostring(lt, "0.00") + '","usd":"' + str.tostring(usd, "0") + '","setup":"' + jq(st) + '","bias":"' + jq(bt) + '","why":"' + jq(wy) + '","t":"' + str.format_time(time, "HH:mm", "UTC") + '"}'
hookMove(string sd, float en, float oldSl, float newSl, float mfe, float dr) => '{"k":"' + hookSecret + '","ev":"move","sym":"' + syminfo.ticker + '","side":"' + sd + '","entry":"' + fmt(en) + '","oldsl":"' + fmt(oldSl) + '","newsl":"' + fmt(newSl) + '","mfe":"' + str.tostring(mfe, "0.0") + '","day":"' + str.tostring(dr, "0.00") + '","t":"' + str.format_time(time, "HH:mm", "UTC") + '"}'
hookExit(string sd, string res, float en, float ex, float r, float dr) => '{"k":"' + hookSecret + '","ev":"exit","sym":"' + syminfo.ticker + '","side":"' + sd + '","entry":"' + fmt(en) + '","exit":"' + fmt(ex) + '","res":"' + res + '","r":"' + str.tostring(r, "0.00") + '","day":"' + str.tostring(dr, "0.00") + '","t":"' + str.format_time(time, "HH:mm", "UTC") + '"}'


delTrade(int idx) =>
    Trd o = trades.get(idx)
    box.delete(o.rb)
    box.delete(o.wb)
    line.delete(o.el)
    label.delete(o.lb)
    if not na(o.xl)
        label.delete(o.xl)
    if not na(o.tl)
        label.delete(o.tl)
    if not na(o.lotl)
        label.delete(o.lotl)
    if not na(o.whyl)
        label.delete(o.whyl)
    if not na(o.mln)
        line.delete(o.mln)
    if not na(o.tpl)
        label.delete(o.tpl)
    if not na(o.tln)
        line.delete(o.tln)
    if not na(o.pg1)
        box.delete(o.pg1)
    if not na(o.pg2)
        box.delete(o.pg2)
    trades.remove(idx)
trimTrades() =>
    // позиції: останні histN закритих (основні + сценарні разом); відкрита позиція лишається завжди
    int closedN = 0
    int nAll = trades.size()
    if nAll > 0
        for i = 0 to nAll - 1
            Trd t0 = trades.get(i)
            if not t0.open and t0.st == 1
                closedN += 1
    while closedN > histN
        int idx = -1
        int nCur = trades.size()
        for i = 0 to nCur - 1
            Trd t1 = trades.get(i)
            if idx == -1 and not t1.open and t1.st == 1
                idx := i
        if idx == -1
            closedN := 0
        else
            delTrade(idx)
            closedN -= 1
    // лімітки: активні (st 0) + скасовані (st 2) ≤ histLim; активні не видаляються
    int limN = 0
    int nL = trades.size()
    if nL > 0
        for i = 0 to nL - 1
            Trd t2 = trades.get(i)
            if t2.st == 2 or (t2.open and t2.st == 0)
                limN += 1
    while limN > histLim
        int idx2 = -1
        int nC2 = trades.size()
        for i = 0 to nC2 - 1
            Trd t3 = trades.get(i)
            if idx2 == -1 and t3.st == 2
                idx2 := i
        if idx2 == -1
            limN := 0
        else
            delTrade(idx2)
            limN -= 1

// ═════════════ ОСНОВНА ЛОГІКА (лише закриті бари) ═════════════
if barstate.isconfirmed
    // --- зміна дня
    if newWeek or na(wkHi)
        if not na(wkHi) and showPW
            addLevel(wkHi, true, "PWH")
            addLevel(wkLo, false, "PWL")
        wkHi := high
        wkLo := low
        wkR := 0.0
    else
        wkHi := math.max(wkHi, high)
        wkLo := math.min(wkLo, low)
    if newDay or na(dayH)
        if not na(dayH)
            pdh := dayH
            pdl := dayL
            pdc := close[1]
            if showLvls
                addLevel(pdh, true, "PDH")
                addLevel(pdl, false, "PDL")
        dayH := high
        dayL := low
        dayO := open
        dayR := 0.0
    // --- азійська сесія
    if asStart
        asCurH := high
        asCurL := low
        asCurHt := time
        asCurLt := time
    else if inAsia
        if high > asCurH
            asCurH := high
            asCurHt := time
        if low < asCurL
            asCurL := low
            asCurLt := time
    if asEnd and not na(asCurH)
        asH := asCurH
        asL := asCurL
        asHt := asCurHt
        asLt := asCurLt
        if showLvls
            addLevel(asH, true, "ASIA H")
            addLevel(asL, false, "ASIA L")
        // авто-біас (#46, спрощено): екстремум азії на рівні карти + діапазон до екстремуму >= порогу
        float minRng = isFx ? 15.0 * pip : 2.5 * atrV
        float tolMap = isFx ? 20.0 * pip : 60.0
        bool hiAtLvl = false
        bool loAtLvl = false
        int sz0 = lv.size()
        if sz0 > 0
            for i = 0 to sz0 - 1
                Lvl l = lv.get(i)
                if l.tag != "ASIA H" and l.tag != "ASIA L"
                    if l.isHigh and math.abs(asH - l.p) <= tolMap
                        hiAtLvl := true
                    if not l.isHigh and math.abs(asL - l.p) <= tolMap
                        loAtLvl := true
        bool hiOk = hiAtLvl and asHt > asLt and (asH - asL) >= minRng
        bool loOk = loAtLvl and asLt > asHt and (asH - asL) >= minRng
        biasAuto := hiOk and not loOk ? -1 : loOk and not hiOk ? 1 : 0
    // --- відкриття Лондона
    if hour(time, "UTC") == 7 and minute(time, "UTC") == 0
        ldnO := open
    int nyMin = hour(time, "America/New_York") * 60 + minute(time, "America/New_York")
    if nyMin == 0
        dOpenNY := open
        nyO := na
    if nyMin == math.round(nyH * 60)
        nyO := open

    // --- свінги H1 / D
    if showLvls
        if showH1 and not na(phH1) and ptH1 != ptH1[1]
            addLevel(phH1, true, "H1")
        if showH1 and not na(plH1) and ptH1 != ptH1[1]
            addLevel(plH1, false, "H1")
        if showD and not na(phD) and ptD != ptD[1]
            addLevel(phD, true, "D")
        if showD and not na(plD) and ptD != ptD[1]
            addLevel(plD, false, "D")

    // --- зняття / реклейм / сетап
    // --- лімітки: заповнення / скасування (кожна окремо)
    int nT0 = trades.size()
    if nT0 > 0
        for k = nT0 - 1 to 0
            Trd pt = trades.get(k)
            if pt.open and pt.st == 0 and bar_index > pt.b0
                bool tpTouched = pt.side == -1 ? low <= pt.tp : high >= pt.tp
                bool filled = (pt.side == -1 ? high >= pt.entry : low <= pt.entry) and (not pt.fv or tradeWin)
                if filled and not tpTouched
                    pt.st := 1
                    pt.b0 := bar_index - 1
                    pt.fv := false
                    box.set_left(pt.rb, bar_index)
                    box.set_left(pt.wb, bar_index)
                    line.set_x1(pt.el, bar_index)
                    box.set_border_style(pt.rb, line.style_solid)
                    box.set_border_style(pt.wb, line.style_solid)
                    box.set_border_color(pt.rb, visK(false, color.new(colRisk, 40)))
                    box.set_border_color(pt.wb, visK(false, color.new(colRew, 40)))
                    box.set_bgcolor(pt.rb, visK(false, color.new(colRisk, boxTr)))
                    box.set_bgcolor(pt.wb, visK(false, color.new(colRew, boxTr)))
                    if not na(pt.whyl)
                        label.set_color(pt.whyl, visK(false, color.new(#37474f, 8)))
                        label.set_textcolor(pt.whyl, visK(false, color.white))
                    if not na(pt.tpl)
                        label.set_color(pt.tpl, visK(false, color.new(colRew, 10)))
                        label.set_textcolor(pt.tpl, visK(false, color.white))
                    if not na(pt.lotl)
                        label.set_textcolor(pt.lotl, visK(false, color.black))
                        label.set_text(pt.lotl, str.replace(label.get_text(pt.lotl), "◔ ЛІМІТКА · чекає", "✔ ЗАПОВНЕНО"))
                        label.set_color(pt.lotl, visK(false, color.new(#ffd600, 0)))
                    line.set_color(pt.el, visK(false, color.new(color.white, 20)))
                    line.set_style(pt.el, line.style_solid)
                    line.set_extend(pt.el, extend.none)
                    sendHook(hookFill(pt.side == -1 ? "ШОРТ" : "ЛОНГ", pt.entry, pt.sl, pt.tp, pt.lotv, pt.ruv, pt.sTx, pt.bTx, pt.wTx))
                else if tpTouched or bar_index >= pt.exp or (pt.fv ? (not inSess or (pt.side == -1 ? close > pt.inv : close < pt.inv)) : not tradeWin)
                    if showLim and histLim > 0
                        pt.open := false
                        pt.st := 2
                        pt.xbar := bar_index
                        box.set_right(pt.rb, bar_index)
                        box.set_right(pt.wb, bar_index)
                        box.set_border_color(pt.rb, color.new(color.gray, 55))
                        box.set_border_color(pt.wb, color.new(color.gray, 55))
                        box.set_bgcolor(pt.rb, color.new(color.gray, 92))
                        box.set_bgcolor(pt.wb, color.new(color.gray, 92))
                        line.set_x2(pt.el, bar_index)
                        line.set_extend(pt.el, extend.none)
                        line.set_color(pt.el, color.new(color.gray, 30))
                        if not na(pt.lotl)
                            label.set_text(pt.lotl, str.replace(label.get_text(pt.lotl), "◔ ЛІМІТКА · чекає", "✕ ЛІМІТКА · не спрацювала"))
                            label.set_color(pt.lotl, color.new(color.gray, 25))
                            label.set_textcolor(pt.lotl, color.white)
                            label.set_x(pt.lotl, bar_index + 1)
                        if not na(pt.whyl)
                            label.delete(pt.whyl)
                            pt.whyl := na
                        if not na(pt.tpl)
                            label.delete(pt.tpl)
                            pt.tpl := na
                    else
                        box.delete(pt.rb)
                        box.delete(pt.wb)
                        line.delete(pt.el)
                        label.delete(pt.lb)
                        if not na(pt.lotl)
                            label.delete(pt.lotl)
                        if not na(pt.whyl)
                            label.delete(pt.whyl)
                        if not na(pt.tpl)
                            label.delete(pt.tpl)
                        trades.remove(k)
                else
                    box.set_right(pt.rb, bar_index)
                    box.set_right(pt.wb, bar_index)
                    line.set_x2(pt.el, bar_index)
                    if not na(pt.lotl)
                        label.set_x(pt.lotl, bar_index + 1)
                    if not na(pt.tpl)
                        label.set_x(pt.tpl, bar_index + 1)
    trimTrades()
    int bias = biasIn == "Лише шорт" ? -1 : biasIn == "Лише лонг" ? 1 : biasIn == "Обидва боки" ? 0 : biasIn == "Авто (за азією)" ? biasAuto : biasIn == "Тренд D (3 дні)" ? htfTr : (biasAuto == htfTr ? biasAuto : 0)
    curBias := bias
    bool biasKnown = biasIn == "Обидва боки" or bias != 0
    bool chainActive = chainOn and bar_index <= chainUntil
    bool friOk = not (dayofweek(time, "UTC") == dayofweek.friday and minOfDay >= friCut * 60)
    bool canTrade = cntAct() < maxPos and tradeWin and dayR > dayLimit and wkR > wkLimit and friOk and (biasKnown or chainActive) and not na(atrV)
    bool entered = false
    int szL = lv.size()
    if szL > 0
        for i = 0 to szL - 1
            Lvl l = lv.get(i)
            if not l.swept
                if l.isHigh and high > l.hi + sweepMin
                    l.swept := true
                    l.sweepBar := bar_index
                    l.ext := high
                    if na(swHBar) or bar_index - swHBar > 36 or high > swHMax
                        swHBar := bar_index
                        swHTag := l.tag + " " + str.tostring(l.p, format.mintick)
                        swHMax := high
                if (not l.isHigh) and low < l.lo - sweepMin
                    l.swept := true
                    l.sweepBar := bar_index
                    l.ext := low
                    if na(swLBar) or bar_index - swLBar > 36 or low < swLMin
                        swLBar := bar_index
                        swLTag := l.tag + " " + str.tostring(l.p, format.mintick)
                        swLMin := low
                if l.swept
                    if showDead
                        line.set_extend(l.ln, extend.none)
                        line.set_x2(l.ln, bar_index)
                        line.set_color(l.ln, color.new(color.gray, 55))
                        line.set_style(l.ln, line.style_dotted)
                        line.set_width(l.ln, 1)
                        label.set_style(l.lb, label.style_none)
                        label.set_x(l.lb, bar_index)
                        label.set_text(l.lb, "✕ " + (l.n > 1 ? "пул " : "") + l.tag + "  знято")
                        label.set_textcolor(l.lb, color.new(color.gray, 35))
                    else
                        line.delete(l.ln)
                        label.delete(l.lb)
            if l.swept and not l.done
                if l.isHigh
                    l.ext := math.max(l.ext, high)
                else
                    l.ext := math.min(l.ext, low)
                bool crossBack = l.isHigh ? (close < l.lo and (bar_index == l.sweepBar or close[1] >= l.lo)) : (close > l.hi and (bar_index == l.sweepBar or close[1] <= l.hi))
                bool bodyOk = l.isHigh ? (close < open and (open - close) >= minBody * atrV) : (close > open and (close - open) >= minBody * atrV)
                if crossBack
                    l.done := true
                    string skip = ""
                    int sideX = l.isHigh ? -1 : 1
                    if not bodyOk
                        skip := "тіло свічки замале"
                    else if cntAct() >= maxPos
                        skip := "вже є позиція/лімітка"
                    else if not tradeWin
                        skip := "поза вікном входу"
                    else if dayR <= dayLimit
                        skip := "ліміт дня"
                    else if wkR <= wkLimit
                        skip := "ліміт тижня"
                    else if not friOk
                        skip := "п'ятниця після " + str.tostring(friCut, "0.0") + " UTC"
                    else if not (biasKnown or chainActive)
                        skip := "біас не визначено"
                    else if not (bias == 0 or bias == sideX or (chainActive and chainSide == sideX))
                        skip := "проти біасу"
                    else if (bar_index - l.born) < 3
                        skip := "рівень надто свіжий"
                    else if entered
                        skip := "вже є вхід на цьому барі"
                    if bodyOk and canTrade and not entered and (bar_index - l.born) >= 3 and (bias == 0 or bias == (l.isHigh ? -1 : 1) or (chainActive and chainSide == (l.isHigh ? -1 : 1))) and sideOkFn(l.isHigh ? -1 : 1)
                        int side = l.isHigh ? -1 : 1
                        bool isLimit = entryMode != "Ринком на закритті"
                        float obOpen = open
                        if entryMode == "Лімітка на Open OB (свічка перед імпульсом)"
                            for k = 1 to 5
                                if (side == -1 ? close[k] > open[k] : close[k] < open[k])
                                    obOpen := open[k]
                                    break
                        float entry = isLimit ? obOpen : close
                        float maxDist = isFx ? entryFx * pip : entryAtr * atrV
                        if math.abs(close - l.ext) > maxDist
                            skip := "вхід далеко від екстремуму"
                        if math.abs(close - l.ext) <= maxDist
                            float buf = math.max(bufMult * atrV, minStop)
                            float sl = side == -1 ? l.ext + buf : l.ext - buf
                            float bestD = 1e10
                            float edge = na
                            for j = 0 to szL - 1
                                Lvl q = lv.get(j)
                                if not q.swept and q.isHigh == (side == -1)
                                    if side == -1 and q.lo > entry and (q.lo - entry) < bestD
                                        bestD := q.lo - entry
                                        edge := q.hi
                                    if side == 1 and q.hi < entry and (entry - q.hi) < bestD
                                        bestD := entry - q.hi
                                        edge := q.lo
                            if not na(edge)
                                sl := side == -1 ? math.max(sl, edge + 0.5 * pip) : math.min(sl, edge - 0.5 * pip)
                            float risk = math.abs(sl - entry)
                            if not (risk >= riskMinA * atrV and risk <= riskMaxA * atrV and risk >= minStop)
                                skip := "ризик поза межами"
                            if risk >= riskMinA * atrV and risk <= riskMaxA * atrV and risk >= minStop
                                float bestT = 1e10
                                float tp = na
                                Lvl tpQ = na
                                for j = 0 to szL - 1
                                    Lvl q = lv.get(j)
                                    if not q.swept and q.isHigh == (side == 1)
                                        float px = side == -1 ? q.hi : q.lo
                                        float dist = side == -1 ? entry - px : px - entry
                                        if dist > 0 and dist / risk >= rrMin and dist < bestT
                                            bestT := dist
                                            tp := px
                                            tpQ := q
                                if na(tp)
                                    skip := "RR менше мінімуму / немає цілі"
                                if not na(tp)
                                    tNSig += 1
                                    float rr = math.abs(tp - entry) / risk
                                    float rUsd = riskUsdIn > 0 ? riskUsdIn : accSize * riskPct / 100.0
                                    float perUnit = isFx ? fxPipVal : idxPtVal
                                    float riskU = risk / pip
                                    float lotRaw = riskU * perUnit > 0 ? rUsd / (riskU * perUnit) : 0.0
                                    float lot = math.max(math.floor(lotRaw / lotStep) * lotStep, lotStep)
                                    tLot := lot
                                    tRiskUsd := lot * riskU * perUnit
                                    string lotTxt = showLot ? "\n" + str.tostring(lot, "0.00") + " лот · $" + str.tostring(tRiskUsd, "0") : ""
                                    box rb = box.new(bar_index, side == -1 ? sl : entry, bar_index + 1, side == -1 ? entry : sl, border_color = visK(isLimit, color.new(colRisk, 40)), bgcolor = visK(isLimit, color.new(colRisk, boxTr)), border_style = isLimit ? line.style_dashed : line.style_solid)
                                    box wb = box.new(bar_index, side == -1 ? entry : tp, bar_index + 1, side == -1 ? tp : entry, border_color = visK(isLimit, color.new(colRew, 40)), bgcolor = visK(isLimit, color.new(colRew, boxTr)), border_style = isLimit ? line.style_dashed : line.style_solid)
                                    line el = line.new(bar_index, entry, bar_index + 1, entry, color = visK(isLimit, isLimit ? colPend : color.new(color.white, 20)), width = 2, style = isLimit ? line.style_dashed : line.style_solid, extend = isLimit ? extend.right : extend.none)
                                    label lb = label.new(bar_index, entry, "", style = label.style_none, textcolor = color.new(color.white, 100), size = size.tiny)
                                    string plateT = (isLimit ? "◔ ЛІМІТКА · чекає  " : "✔ ЗАПОВНЕНО  ") + (side == -1 ? "▼ ШОРТ " : "▲ ЛОНГ ") + fmt(entry) + "\n" + (showLot ? "ЛОТ " + str.tostring(lot, "0.00") + " · $" + str.tostring(tRiskUsd, "0") + " · " : "") + "RR " + str.tostring(rr, "0.0") + " · ризик " + str.tostring(risk / pip, "0.0") + unitTxt + "\nСЕТАП: " + (isLimit ? (entryMode == "Лімітка на Open OB (свічка перед імпульсом)" ? "лімітка на Open OB" : "лімітка на реклейм") : "ринок на реклейм") + " · знято " + l.tag + " " + fmt(l.p) + "\nБІАС: " + biasWord(bias) + " · " + biasMode()
                                    label lotLb = label.new(bar_index + 1, entry, plateT, style = label.style_label_left, color = visK(isLimit, isLimit ? colPend : color.new(#ffd600, 0)), textcolor = visK(isLimit, color.black), size = lotSz)
                                    string setupT = (isLimit ? (entryMode == "Лімітка на Open OB (свічка перед імпульсом)" ? "лімітка на Open OB" : "лімітка на реклейм") : "ринок на реклейм") + " · знято " + l.tag + " " + fmt(l.p)
                                    string biasT = biasWord(bias) + " · " + biasMode()
                                    string zTxt = zoneAt(l.ext)
                                    string whyB = (zTxt != "" ? "ціна прийшла в " + zTxt + " · " : "") + "біас " + biasWord(bias) + " (" + biasMode() + ") · знято " + l.tag + " " + fmt(l.p) + " → імпульсний реклейм → " + (isLimit ? "ліміт" : "ринок")
                                    string whyTxt = "ЧОМУ: " + whyB
                                    label whyLb = label.new(l.sweepBar, sl, whyTxt, style = side == -1 ? label.style_label_down : label.style_label_up, color = visK(isLimit, color.new(#37474f, 8)), textcolor = visK(isLimit, color.white), size = lblSize)
                                    label tpLb = label.new(bar_index + 1, tp, "ЦІЛЬ " + fmt(tp) + " · " + tpWhy(tpQ) + " · RR " + str.tostring(rr, "0.0"), style = label.style_label_left, color = visK(isLimit, color.new(colRew, 10)), textcolor = visK(isLimit, color.white), size = lblSize)
                                    trades.push(Trd.new(rb, wb, el, lb, na, side, entry, sl, tp, na, true, false, false, na, na, lotLb, whyLb, tpLb, na, isLimit ? 0 : 1, bar_index, bar_index + pendBars, false, na, lot, tRiskUsd, setupT, biasT, whyB, risk, 0.0, false, na, false, na, na, 0.0, 0.0))
                                    trimTrades()
                                    if not isLimit
                                        sendHook(hookFill(side == -1 ? "ШОРТ" : "ЛОНГ", entry, sl, tp, lot, tRiskUsd, setupT, biasT, whyB))
                                    entered := true
                else if bar_index - l.sweepBar >= maxAge
                    l.done := true

    // --- M15-свічки з барів M5 + FVG-ліміт ноги зняття
    if time % 900000 == 0 or na(cH)
        cO := open
        cH := high
        cL := low
    else
        cH := math.max(cH, high)
        cL := math.min(cL, low)
    cC := close
    if not na(swHBar) and bar_index > swHBar
        swHMax := math.max(swHMax, high)
    if not na(swLBar) and bar_index > swLBar
        swLMin := math.min(swLMin, low)
    bool m15Last = (time + 300000) % 900000 == 0
    bool canFvg = fvgBase ? (cntAct() < maxPos and inSess and dayR > dayLimit and wkR > wkLimit and friOk and (biasKnown or chainActive) and not na(atrV)) : canTrade
    if fvgOn and m15Last and canFvg and not entered and not na(o1) and not na(o2) and not na(atrV)
        for dirn = -1 to 1 by 2
            int swB = dirn == -1 ? swHBar : swLBar
            float swE = dirn == -1 ? swHMax : swLMin
            if not entered and not na(swB) and bar_index - swB <= 36 and (bias == 0 or bias == dirn) and sideOkFn(dirn)
                float gLo = dirn == -1 ? cH : h1
                float gHi = dirn == -1 ? l1 : cL
                bool okG = gHi > gLo and (gHi - gLo) >= fvgMin * pip and (dirn == -1 ? c2 < o2 : c2 > o2)
                if okG
                    float fEntry = dirn == -1 ? gLo : gHi
                    float fSl = dirn == -1 ? swE + fvgBuf * pip : swE - fvgBuf * pip
                    float fRisk = math.abs(fSl - fEntry)
                    if fRisk >= riskMinA * atrV and fRisk <= fvgRiskAtr * atrV and fRisk >= minStop
                        float fBest = 1e10
                        float fTp = na
                        Lvl fQ = na
                        int nF = lv.size()
                        if nF > 0
                            for j = 0 to nF - 1
                                Lvl q = lv.get(j)
                                if not q.swept and q.isHigh == (dirn == 1)
                                    float fpx = dirn == -1 ? q.hi : q.lo
                                    float fdist = dirn == -1 ? fEntry - fpx : fpx - fEntry
                                    if fdist > 0 and fdist / fRisk >= rrMin and fdist < fBest
                                        fBest := fdist
                                        fTp := fpx
                                        fQ := q
                        if not na(fTp)
                            tNSig += 1
                            float fRr = math.abs(fTp - fEntry) / fRisk
                            float fUsd = riskUsdIn > 0 ? riskUsdIn : accSize * riskPct / 100.0
                            float fUnit = isFx ? fxPipVal : idxPtVal
                            float fRu = fRisk / pip
                            float fLotRaw = fRu * fUnit > 0 ? fUsd / (fRu * fUnit) : 0.0
                            float fLot = math.max(math.floor(fLotRaw / lotStep) * lotStep, lotStep)
                            tLot := fLot
                            tRiskUsd := fLot * fRu * fUnit
                            string fLotTxt = showLot ? "\n" + str.tostring(fLot, "0.00") + " лот · $" + str.tostring(tRiskUsd, "0") : ""
                            box frb = box.new(bar_index, dirn == -1 ? fSl : fEntry, bar_index + 1, dirn == -1 ? fEntry : fSl, border_color = visK(true, color.new(colRisk, 40)), bgcolor = visK(true, color.new(colRisk, boxTr)), border_style = line.style_dashed)
                            box fwb = box.new(bar_index, dirn == -1 ? fEntry : fTp, bar_index + 1, dirn == -1 ? fTp : fEntry, border_color = visK(true, color.new(colRew, 40)), bgcolor = visK(true, color.new(colRew, boxTr)), border_style = line.style_dashed)
                            line fel = line.new(bar_index, fEntry, bar_index + 1, fEntry, color = visK(true, colPend), width = 2, style = line.style_dashed, extend = extend.right)
                            label flb = label.new(bar_index, fEntry, "", style = label.style_none, textcolor = color.new(color.white, 100), size = size.tiny)
                            string fPlateT = "◔ ЛІМІТКА · чекає  " + (dirn == -1 ? "▼ ШОРТ " : "▲ ЛОНГ ") + fmt(fEntry) + "\n" + (showLot ? "ЛОТ " + str.tostring(fLot, "0.00") + " · $" + str.tostring(tRiskUsd, "0") + " · " : "") + "RR " + str.tostring(fRr, "0.0") + " · ризик " + str.tostring(fRu, "0.0") + unitTxt + "\nСЕТАП: FVG-ліміт M15 · знято " + (dirn == -1 ? swHTag : swLTag) + "\nБІАС: " + biasWord(bias) + " · " + biasMode()
                            label fLotLb = label.new(bar_index + 1, fEntry, fPlateT, style = label.style_label_left, color = visK(true, colPend), textcolor = visK(true, color.black), size = lotSz)
                            string fZ = zoneAt(swE)
                            string fSetupT = "FVG-ліміт M15 · знято " + (dirn == -1 ? swHTag : swLTag)
                            string fBiasT = biasWord(bias) + " · " + biasMode()
                            string fWhyB = (fZ != "" ? "ціна прийшла в " + fZ + " · " : "") + "біас " + biasWord(bias) + " (" + biasMode() + ") · знято " + (dirn == -1 ? swHTag : swLTag) + " → імпульс " + (dirn == -1 ? "вниз" : "вгору") + " залишив FVG M15 → ліміт на його ближній край"
                            string fWhy = "ЧОМУ: " + fWhyB
                            label fWhyLb = label.new(swB, fSl, fWhy, style = dirn == -1 ? label.style_label_down : label.style_label_up, color = visK(true, color.new(#37474f, 8)), textcolor = visK(true, color.white), size = lblSize)
                            label fTpLb = label.new(bar_index + 1, fTp, "ЦІЛЬ " + fmt(fTp) + " · " + tpWhy(fQ) + " · RR " + str.tostring(fRr, "0.0"), style = label.style_label_left, color = visK(true, color.new(colRew, 10)), textcolor = visK(true, color.white), size = lblSize)
                            trades.push(Trd.new(frb, fwb, fel, flb, na, dirn, fEntry, fSl, fTp, na, true, false, false, na, na, fLotLb, fWhyLb, fTpLb, na, 0, bar_index, bar_index + fvgExp, true, swE, fLot, tRiskUsd, fSetupT, fBiasT, fWhyB, fRisk, 0.0, false, na, false, na, na, 0.0, 0.0))
                            trimTrades()
                            entered := true
    if m15Last
        o1 := o2
        h1 := h2
        l1 := l2
        c1 := c2
        o2 := cO
        h2 := cH
        l2 := cL
        c2 := cC

    // --- сценарії: заповнення лімітки → справжня позиція
    if showScen and not na(atrV) and not na(atrD)
        if newDay
            scUsed.clear()
        for dirn = -1 to 1 by 2
            int ix = dirn == -1 ? 0 : 1
            float oe = scEn.get(ix)
            if not na(oe) and bar_index > scBr.get(ix)
                float oSl = scSl.get(ix)
                float oTp = scTp.get(ix)
                bool touched = dirn == -1 ? high >= oe : low <= oe
                bool slHit = dirn == -1 ? high >= oSl : low <= oSl
                bool tpHit = dirn == -1 ? low <= oTp : high >= oTp
                bool allow = cntActSc() < 2 and tradeWin and (curBias == 0 or curBias == dirn)
                if touched and not slHit and not tpHit and allow
                    float oR = math.abs(oSl - oe)
                    float oRr = math.abs(oTp - oe) / oR
                    float oUsd = riskUsdIn > 0 ? riskUsdIn : accSize * riskPct / 100.0
                    float oUnit = isFx ? fxPipVal : idxPtVal
                    float oRu = oR / pip
                    float oLotRaw = oRu * oUnit > 0 ? oUsd / (oRu * oUnit) : 0.0
                    float oLot = math.max(math.floor(oLotRaw / lotStep) * lotStep, lotStep)
                    float oUsdReal = oLot * oRu * oUnit
                    int xs = bar_index
                    string oSetup = "сценарій: лімітка в " + scOr.get(ix)
                    string oBias = biasWord(curBias) + " · " + biasMode()
                    string oWhy = "ціна дійшла до " + scOr.get(ix) + " · біас " + oBias + " → лімітка спрацювала"
                    box orb = box.new(xs, dirn == -1 ? oSl : oe, bar_index + 1, dirn == -1 ? oe : oSl, border_color = visK(false, color.new(colRisk, 40)), bgcolor = visK(false, color.new(colRisk, boxTr)))
                    box owb = box.new(xs, dirn == -1 ? oe : oTp, bar_index + 1, dirn == -1 ? oTp : oe, border_color = visK(false, color.new(colRew, 40)), bgcolor = visK(false, color.new(colRew, boxTr)))
                    line oel = line.new(xs, oe, bar_index + 1, oe, color = visK(false, color.new(color.white, 20)), width = 2)
                    label olb = label.new(xs, oe, "", style = label.style_none, textcolor = color.new(color.white, 100), size = size.tiny)
                    label olot = label.new(bar_index + 1, oe, "✔ ЗАПОВНЕНО  СЦЕНАРІЙ " + (dirn == -1 ? "▼ ШОРТ " : "▲ ЛОНГ ") + fmt(oe) + "\n" + (showLot ? "ЛОТ " + str.tostring(oLot, "0.00") + " · $" + str.tostring(oUsdReal, "0") + " · " : "") + "RR " + str.tostring(oRr, "0.0") + " · ризик " + str.tostring(oRu, "0.0") + unitTxt + "\nСЕТАП: " + oSetup + "\nБІАС: " + oBias, style = label.style_label_left, color = visK(false, color.new(#ffd600, 0)), textcolor = visK(false, color.black), size = lotSz)
                    label owhy = label.new(xs, oSl, "ЧОМУ: " + oWhy, style = dirn == -1 ? label.style_label_down : label.style_label_up, color = visK(false, color.new(#37474f, 8)), textcolor = visK(false, color.white), size = lblSize)
                    label otp = label.new(bar_index + 1, oTp, "ЦІЛЬ " + fmt(oTp) + " · " + scTt.get(ix) + " · RR " + str.tostring(oRr, "0.0"), style = label.style_label_left, color = visK(false, color.new(colRew, 10)), textcolor = visK(false, color.white), size = lblSize)
                    trades.push(Trd.new(orb, owb, oel, olb, na, dirn, oe, oSl, oTp, na, true, false, false, na, na, olot, owhy, otp, na, 1, bar_index, bar_index, false, na, oLot, oUsdReal, oSetup, oBias, oWhy, oR, 0.0, false, na, true, na, na, 0.0, 0.0))
                    trimTrades()
                    tNSig += 1
                    sendHook(hookFill(dirn == -1 ? "ШОРТ" : "ЛОНГ", oe, oSl, oTp, oLot, oUsdReal, oSetup, oBias, oWhy))
                    scUsed.push(oe)
                scEn.set(ix, na)
        if cntActSc() < 2
            for dirn = -1 to 1 by 2
                int ix = dirn == -1 ? 0 : 1
                if (curBias == 0 or curBias == dirn) and tradeWin
                    [ok2, e2, sl2s, tp2s, d2, o2, t2, r2] = scenFor(dirn)
                    if ok2
                        scEn.set(ix, e2)
                        scSl.set(ix, sl2s)
                        scTp.set(ix, tp2s)
                        scOr.set(ix, o2)
                        scTt.set(ix, t2)
                        scBr.set(ix, bar_index)
                        scDs.set(ix, d2)
                    else
                        scEn.set(ix, na)
                else
                    scEn.set(ix, na)

    // --- супровід відкритих угод (кожна окремо)
    int nM = trades.size()
    if nM > 0
        for k = 0 to nM - 1
            Trd cur = trades.get(k)
            if cur.open and cur.st == 1 and bar_index > cur.b0
                int wEdge = math.max(bar_index, cur.b0 + minPosBars)
                box.set_right(cur.rb, wEdge)
                box.set_right(cur.wb, wEdge)
                line.set_x2(cur.el, wEdge)
                if not na(cur.lotl)
                    label.set_x(cur.lotl, wEdge + 1)
                if not na(cur.tpl)
                    label.set_x(cur.tpl, wEdge + 1)
                // прогрес: де ціна вже пройшла — темніше (як у TradingView)
                float entryX = cur.entry
                float favP = cur.side == -1 ? math.max(entryX - low, 0.0) : math.max(high - entryX, 0.0)
                float advP = cur.side == -1 ? math.max(high - entryX, 0.0) : math.max(entryX - low, 0.0)
                cur.mxF := math.min(math.max(cur.mxF, favP), math.abs(cur.tp - entryX))
                cur.mxA := math.min(math.max(cur.mxA, advP), math.abs(cur.sl - entryX))
                int xl = box.get_left(cur.rb)
                float gT = cur.side == -1 ? entryX : entryX + cur.mxF
                float gB = cur.side == -1 ? entryX - cur.mxF : entryX
                float rT = cur.side == -1 ? entryX + cur.mxA : entryX
                float rB = cur.side == -1 ? entryX : entryX - cur.mxA
                if na(cur.pg1)
                    cur.pg1 := box.new(xl, gT, bar_index, gB, border_color = na, bgcolor = visK(false, color.new(colRew, math.max(boxTr - 50, 20))))
                    cur.pg2 := box.new(xl, rT, bar_index, rB, border_color = na, bgcolor = visK(false, color.new(colRisk, math.max(boxTr - 50, 20))))
                else
                    box.set_top(cur.pg1, gT)
                    box.set_bottom(cur.pg1, gB)
                    box.set_right(cur.pg1, bar_index)
                    box.set_top(cur.pg2, rT)
                    box.set_bottom(cur.pg2, rB)
                    box.set_right(cur.pg2, bar_index)
                bool hitSl = cur.side == -1 ? high >= cur.sl : low <= cur.sl
                bool hitTp = cur.side == -1 ? low <= cur.tp : high >= cur.tp
                float exitPx = na
                string why = ""
                if hitSl
                    exitPx := cur.sl
                    why := cur.mv ? "СТОП ЗАХИСТ" : "СТОП"
                else if hitTp
                    exitPx := cur.tp
                    why := "ЦІЛЬ"
                else if minOfDay >= sessTo - 5
                    exitPx := close
                    why := "ЗАКРИТО ПО ЧАСУ"
                if not na(exitPx)
                    float riskX = cur.r0
                    float rX = cur.side * (exitPx - cur.entry) / riskX
                    if not cur.sc
                        dayR += rX
                        wkR += rX
                        if why == "ЦІЛЬ"
                            chainSide := -cur.side
                            chainUntil := bar_index + 8
                        lastR := rX
                    cur.r := rX
                    cur.open := false
                    cur.xbar := bar_index
                    int fEdge = math.max(bar_index, cur.b0 + (why == "СТОП" or why == "СТОП ЗАХИСТ" ? minStopBars : minPosBars))
                    box.set_right(cur.rb, fEdge)
                    box.set_right(cur.wb, fEdge)
                    line.set_x2(cur.el, fEdge)
                    if not na(cur.lotl)
                        label.set_x(cur.lotl, fEdge + 1)
                    if not na(cur.tpl)
                        label.set_x(cur.tpl, fEdge + 1)
                    if why == "СТОП"
                        cur.sh := true
                        cur.tln := line.new(bar_index, cur.tp, bar_index, cur.tp, color = visK(false, color.new(colRew, 25)), style = line.style_dotted, width = 2)
                    cur.xl := label.new(bar_index, exitPx, why + "  " + sgn(rX) + "R", style = label.style_label_left, color = visK(false, rX > 0 ? color.new(colRew, 0) : rX < 0 ? color.new(colRisk, 0) : color.new(color.gray, 0)), textcolor = visK(false, color.white), size = lblSize)
                    sendHook(hookExit((cur.sc ? "СЦЕНАРІЙ " : "") + (cur.side == -1 ? "ШОРТ" : "ЛОНГ"), why, cur.entry, exitPx, rX, dayR))
                else if protOn and not cur.mv
                    float mfeR = cur.side == -1 ? (cur.entry - low) / cur.r0 : (high - cur.entry) / cur.r0
                    cur.mfe := math.max(cur.mfe, mfeR)
                    if shiftBar == bar_index - 1 and shiftDir == -cur.side and cur.mfe >= protMinR
                        float newSl = cur.entry + cur.side * protLock * cur.r0
                        if (cur.side == -1 and close < newSl) or (cur.side == 1 and close > newSl)
                            float oldSl = cur.sl
                            cur.sl := newSl
                            cur.mv := true
                            cur.mln := line.new(bar_index, newSl, bar_index + 1, newSl, color = visK(false, color.new(#ffd600, 0)), width = 2, style = line.style_dashed, extend = extend.right)
                            label mvLb = label.new(bar_index, newSl, "🛡 СТОП ПЕРЕНЕСЕНО · Shift проти позиції · " + fmt(newSl), style = cur.side == -1 ? label.style_label_down : label.style_label_up, color = visK(false, color.new(#ffd600, 0)), textcolor = visK(false, color.black), size = lblSize)
                            sendHook(hookMove(cur.side == -1 ? "ШОРТ" : "ЛОНГ", cur.entry, oldSl, newSl, cur.mfe, dayR))

    // --- після стопу: чи дійшла б ціль пізніше (бокс цілі тягнеться до неї або до кінця сесії)
    int nSh = trades.size()
    if nSh > 0
        for i = 0 to nSh - 1
            Trd sh = trades.get(i)
            if sh.sh and bar_index > sh.xbar
                bool reached = sh.side == -1 ? low <= sh.tp : high >= sh.tp
                line.set_x2(sh.tln, bar_index)
                if reached
                    sh.sh := false
                    sh.late := true
                    sh.tl := label.new(bar_index, sh.tp, "ціль пізніше ✓", style = label.style_label_left, color = visK(false, color.new(colRew, 35)), textcolor = visK(false, color.white), size = lblSize)
                else if minOfDay >= sessTo - 5 or newDay
                    sh.sh := false

    // --- підсумок активних позицій (для таблиці)
    int cntOo = 0
    int cntPp = 0
    int nD = trades.size()
    if nD > 0
        for i = 0 to nD - 1
            Trd td = trades.get(i)
            if td.open
                if td.st == 1
                    cntOo += 1
                    tSide := td.side
                    tEntry := td.entry
                    tSl := td.sl
                    tTp := td.tp
                else
                    cntPp += 1
                    pSide := td.side
                    pEntry := td.entry
                    pSl := td.sl
                    pTp := td.tp
    cntO := cntOo
    cntP := cntPp
    tOn := cntOo > 0
    pOn := cntPp > 0

    // --- денні екстремуми (після логіки зняття, щоб зняття старого екстремуму було видно)
    bool newHigh = high > dayH
    bool newLow = low < dayL
    if newHigh
        dayH := high
    if newLow
        dayL := low
    if showLvls
        if newHigh
            addLevel(dayH, true, "DAY")
        if newLow
            addLevel(dayL, false, "DAY")
    int k = lv.size() - 1
    while k >= 0
        Lvl q2 = lv.get(k)
        if q2.tag == "DAY" and q2.swept and q2.done
            dropLvl(k)
        k -= 1

    // --- зони
    if showFvg or showOb
        procHtf("H1", showH1, 3.0 * pip * fvgScl, tH1, tH1[1], tH1a, tH1b, tH1c, oH1_1, hH1_1, lH1_1, cH1_1, oH1_2, hH1_2, lH1_2, cH1_2, oH1_3, hH1_3, lH1_3, cH1_3, oH1_4, hH1_4, lH1_4, cH1_4, oH1_5, hH1_5, lH1_5, cH1_5, avH1)
        procHtf("H4", showH4, 5.0 * pip * fvgScl, tH4, tH4[1], tH4a, tH4b, tH4c, oH4_1, hH4_1, lH4_1, cH4_1, oH4_2, hH4_2, lH4_2, cH4_2, oH4_3, hH4_3, lH4_3, cH4_3, oH4_4, hH4_4, lH4_4, cH4_4, oH4_5, hH4_5, lH4_5, cH4_5, avH4)
        procHtf("D", showD, 15.0 * pip * fvgScl, tD1, tD1[1], tD1a, tD1b, tD1c, oD_1, hD_1, lD_1, cD_1, oD_2, hD_2, lD_2, cD_2, oD_3, hD_3, lD_3, cD_3, oD_4, hD_4, lD_4, cD_4, oD_5, hD_5, lD_5, cD_5, avD)
        updateZones()

// ───────────── Структура ринку на поточному ТФ: BOS / Shift / боковик
float phS = ta.pivothigh(high, swLen, swLen)
float plS = ta.pivotlow(low, swLen, swLen)
[diPl, diMi, adxV] = ta.dmi(14, 14)
float rHi = ta.highest(high, rngLen)
float rLo = ta.lowest(low, rngLen)

var float sh1 = na
var float sh2 = na
var int   sh1i = na
var int   sh2i = na
var float sl1 = na
var float sl2 = na
var int   sl1i = na
var int   sl2i = na
var int   sh1t = na
var int   sl1t = na
var label sh1Lb = na
var label sl1Lb = na
var array<label> swLbls = array.new<label>()
var int   strTrend = 0
var bool  brkH = true
var bool  brkL = true
var string lastStruct = "—"
var array<line>  mLines  = array.new<line>()
var array<label> mLabels = array.new<label>()
var array<box>   rngBoxes = array.new<box>()
var bool  inRng = false
var box   rngBox = na
var float rngHiV = na
var float rngLoV = na
var int   rngStart = na

if barstate.isconfirmed
    if not na(phS)
        sh2 := sh1
        sh2i := sh1i
        sh1 := phS
        sh1i := bar_index - swLen
        sh1t := time[swLen]
        brkH := false
        if showSwings
            sh1Lb := label.new(sh1i, phS, "SH", style = label.style_label_down, color = colSwH, textcolor = color.white, size = size.small)
            swLbls.push(sh1Lb)
    if not na(plS)
        sl2 := sl1
        sl2i := sl1i
        sl1 := plS
        sl1i := bar_index - swLen
        sl1t := time[swLen]
        brkL := false
        if showSwings
            sl1Lb := label.new(sl1i, plS, "SL", style = label.style_label_up, color = colSwL, textcolor = color.white, size = size.small)
            swLbls.push(sl1Lb)
    // --- злам вгору (BOS ▲ або Shift ▲)
    if not brkH and not na(sh1) and close > sh1
        brkH := true
        bool isShift = strTrend == -1
        strTrend := 1
        lastStruct := isShift ? "Shift ▲" : "BOS ▲"
        if isShift
            shiftBar := bar_index
            shiftDir := 1
        if showSwings and not na(sh1Lb)
            label.set_text(sh1Lb, "SH ✕ " + lastStruct)
            label.set_color(sh1Lb, color.new(isShift ? colShift : colBos, 15))
            label.set_textcolor(sh1Lb, isShift ? color.black : color.white)
            label.set_size(sh1Lb, size.small)
        if showStruct
            line ln = line.new(sh1i, sh1, bar_index, sh1, color = isShift ? colShift : colBos, width = 2, style = line.style_dashed)
            label lb = label.new(math.round(math.avg(sh1i, bar_index)), sh1, lastStruct + " ← SH " + fmt(sh1) + " · " + str.format_time(sh1t, "dd.MM HH:mm", "UTC"), style = label.style_label_down, color = color.new(isShift ? colShift : colBos, 10), textcolor = isShift ? color.black : color.white, size = lblSize)
            mLines.push(ln)
            mLabels.push(lb)
    // --- злам вниз (BOS ▼ або Shift ▼)
    if not brkL and not na(sl1) and close < sl1
        brkL := true
        bool isShift = strTrend == 1
        strTrend := -1
        lastStruct := isShift ? "Shift ▼" : "BOS ▼"
        if isShift
            shiftBar := bar_index
            shiftDir := -1
        if showSwings and not na(sl1Lb)
            label.set_text(sl1Lb, "SL ✕ " + lastStruct)
            label.set_color(sl1Lb, color.new(isShift ? colShift : colBos, 15))
            label.set_textcolor(sl1Lb, isShift ? color.black : color.white)
            label.set_size(sl1Lb, size.small)
        if showStruct
            line ln = line.new(sl1i, sl1, bar_index, sl1, color = isShift ? colShift : colBos, width = 2, style = line.style_dashed)
            label lb = label.new(math.round(math.avg(sl1i, bar_index)), sl1, lastStruct + " ← SL " + fmt(sl1) + " · " + str.format_time(sl1t, "dd.MM HH:mm", "UTC"), style = label.style_label_up, color = color.new(isShift ? colShift : colBos, 10), textcolor = isShift ? color.black : color.white, size = lblSize)
            mLines.push(ln)
            mLabels.push(lb)
    while mLines.size() > maxMarks
        line.delete(mLines.shift())
        label.delete(mLabels.shift())
    while swLbls.size() > maxSwings
        label.delete(swLbls.shift())
    // --- боковик
    if showRange
        bool compact = not na(atrV) and bar_index > rngLen and (rHi - rLo) <= rngMaxAtr * atrV and adxV < adxMax and math.abs(close - close[rngLen - 1]) <= 0.5 * (rHi - rLo)
        if not inRng and compact
            inRng := true
            rngHiV := rHi
            rngLoV := rLo
            rngStart := bar_index - rngLen + 1
            rngBox := box.new(rngStart, rngHiV, bar_index + 1, rngLoV, border_color = colRng, border_width = 2, border_style = line.style_dashed, bgcolor = color.new(colRng, 86), text = "Акумуляція · боковик", text_color = color.new(colRng, 0), text_size = lblSize, text_halign = text.align_left, text_valign = text.align_top)
            rngBoxes.push(rngBox)
            if rngBoxes.size() > 10
                box.delete(rngBoxes.shift())
        else if inRng
            bool outUp = close > rngHiV + 0.2 * nz(atrV, 0.0)
            bool outDn = close < rngLoV - 0.2 * nz(atrV, 0.0)
            bool tooTall = (rngHiV - rngLoV) > 1.5 * rngMaxAtr * nz(atrV, 1.0)
            if outUp or outDn or tooTall
                inRng := false
                box.set_text(rngBox, "Акумуляція · боковик · " + str.tostring(bar_index - rngStart) + " барів" + (outUp ? " → вихід ▲" : outDn ? " → вихід ▼" : ""))
                box.set_right(rngBox, bar_index)
            else
                rngHiV := math.max(rngHiV, high)
                rngLoV := math.min(rngLoV, low)
                box.set_top(rngBox, rngHiV)
                box.set_bottom(rngBox, rngLoV)
                box.set_right(rngBox, bar_index)
                box.set_text(rngBox, "Акумуляція · боковик · " + str.tostring(bar_index - rngStart + 1) + " барів")

// ───────────── AMD: Accumulation (Азія до передранку) → Manipulation (зняття меж) → Distribution
var array<box>   amBoxes = array.new<box>()
var array<label> amLbls  = array.new<label>()
var box    amBox = na
var int    asBar0 = na
var float  asOpen0 = na
var float  accHv = na
var float  accLv = na
var int    amState = 0
var bool   amDone = false
var bool   amChecked = false
var string amInfo = "—"
if barstate.isconfirmed and showAmd
    float hrN = hour(time, "UTC") + minute(time, "UTC") / 60.0
    if asStart
        asBar0 := bar_index
        asOpen0 := open
        accHv := high
        accLv := low
        amChecked := false
        amState := 0
        amDone := false
        amBox := na
        amInfo := "—"
    else if inAsia and hrN < accEnd + (hrN >= 22.0 ? 24.0 : 0.0) and not na(accHv)
        accHv := math.max(accHv, high)
        accLv := math.min(accLv, low)
    // кінець акумуляції: перший бар після accEnd (а не після 06:00)
    if not amChecked and not na(accHv) and not na(atrV) and hrN >= accEnd and hrN < accEnd + 1.0
        amChecked := true
        float rg = accHv - accLv
        float net = math.abs(close[1] - nz(asOpen0, close[1]))
        if rg < accMinAtr * atrV
            amInfo := "Азія вузька"
        else if rg > accMaxAtr * atrV
            amInfo := "Азія широка: не акумуляція"
        else if net > amNetMax * rg
            amInfo := "Азія трендова: не акумуляція"
        else
            amBox := box.new(nz(asBar0, bar_index - 84), accHv, bar_index, accLv, border_color = colAcc, border_width = 2, bgcolor = color.new(colAcc, 88), text = "A · Акумуляція (Азія до " + str.tostring(accEnd, "0.#") + ":00 UTC) · " + str.tostring(rg / pip, "0") + unitTxt, text_color = colAcc, text_size = lblSize, text_halign = text.align_left, text_valign = text.align_top)
            amBoxes.push(amBox)
            if amBoxes.size() > 4
                box.delete(amBoxes.shift())
            amInfo := "A ✓ " + str.tostring(rg / pip, "0") + unitTxt
    if not na(amBox) and hrN < 16.0 and hrN >= accEnd
        box.set_right(amBox, bar_index)
    bool amWin = not na(amBox) and hrN >= accEnd and hrN < 14.0
    if amWin and amState == 0
        bool upSw = high > accHv + sweepMin
        bool dnSw = low < accLv - sweepMin
        if upSw and not dnSw
            amState := 1
            amInfo := "A ✓ → M ▲ " + str.format_time(time, "HH:mm", "UTC") + " → D ▼ ?"
        else if dnSw and not upSw
            amState := -1
            amInfo := "A ✓ → M ▼ " + str.format_time(time, "HH:mm", "UTC") + " → D ▲ ?"
    if not na(amBox) and amState != 0 and not amDone and hrN >= accEnd
        if amState == 1 and close < accLv
            amDone := true
            amInfo := "A ✓ → M ▲ → D ▼ ✓"
            amLbls.push(label.new(bar_index, close, "D ▼ Distribution · закриття нижче акумуляції", style = label.style_label_up, color = color.new(colDis, 5), textcolor = color.black, size = lblSize))
        else if amState == -1 and close > accHv
            amDone := true
            amInfo := "A ✓ → M ▼ → D ▲ ✓"
            amLbls.push(label.new(bar_index, close, "D ▲ Distribution · закриття вище акумуляції", style = label.style_label_down, color = color.new(colDis, 5), textcolor = color.black, size = lblSize))
    while amLbls.size() > 12
        label.delete(amLbls.shift())

// ───────────── Де буде найближчий Shift / BOS (рівні-тригери)
var line  shLn = na
var line  bsLn = na
var label shLb = na
var label bsLb = na
if barstate.islast
    line.delete(shLn)
    line.delete(bsLn)
    label.delete(shLb)
    label.delete(bsLb)
    if showShiftLvl and strTrend != 0
        float shP = strTrend == 1 ? sl1 : sh1
        int   shI = strTrend == 1 ? sl1i : sh1i
        float bsP = strTrend == 1 ? sh1 : sl1
        int   bsI = strTrend == 1 ? sh1i : sl1i
        int   shT = strTrend == 1 ? sl1t : sh1t
        int   bsT = strTrend == 1 ? sh1t : sl1t
        string shSw = (strTrend == 1 ? " · від SL " : " · від SH ") + (na(shT) ? "" : str.format_time(shT, "dd.MM HH:mm", "UTC"))
        string bsSw = (strTrend == 1 ? " · від SH " : " · від SL ") + (na(bsT) ? "" : str.format_time(bsT, "dd.MM HH:mm", "UTC"))
        if not na(shP)
            shLn := line.new(shI, shP, bar_index + 12, shP, color = colShift, width = 2, style = line.style_dotted, extend = extend.right)
            shLb := label.new(bar_index - 30, shP, "SHIFT " + (strTrend == 1 ? "▼ якщо закриття нижче " : "▲ якщо закриття вище ") + fmt(shP) + "  (" + (strTrend == 1 ? "−" : "+") + str.tostring(math.abs(close - shP) / pip, "0.0") + unitTxt + ")" + shSw, style = label.style_label_down, color = color.new(colShift, 5), textcolor = color.black, size = lblSize)
        if not na(bsP)
            bsLn := line.new(bsI, bsP, bar_index + 12, bsP, color = colBos, width = 1, style = line.style_dotted, extend = extend.right)
            bsLb := label.new(bar_index - 30, bsP, "BOS " + (strTrend == 1 ? "▲ якщо закриття вище " : "▼ якщо закриття нижче ") + fmt(bsP) + "  (" + (strTrend == 1 ? "+" : "−") + str.tostring(math.abs(close - bsP) / pip, "0.0") + unitTxt + ")" + bsSw, style = label.style_label_up, color = color.new(colBos, 15), textcolor = color.white, size = lblSize)

// ───────────── Найближча підтримка й найближчий опір (завжди, зі «свіченням»)
var box resB = na
var box supB = na
var box resG1 = na
var box resG2 = na
var box supG1 = na
var box supG2 = na
var label resL = na
var label supL = na
if barstate.islast
    box.delete(resB)
    box.delete(supB)
    box.delete(resG1)
    box.delete(resG2)
    box.delete(supG1)
    box.delete(supG2)
    label.delete(resL)
    label.delete(supL)
    if showNear
        float upD = 1e10
        float dnD = 1e10
        float upLo = na
        float upHi = na
        float dnLo = na
        float dnHi = na
        string upT = ""
        string dnT = ""
        string upX = ""
        string dnX = ""
        int nzz = zn.size()
        if nzz > 0
            for i = 0 to nzz - 1
                Zn z = zn.get(i)
                if not z.dead
                    string nm = tfName(z.tf) + (z.isFvg ? " FVG" : " Order Block") + (z.bull ? " ▲" : " ▼")
                    string dsc = z.isFvg ? "FVG — гап справедливої вартості (дисбаланс цін)" : "Order Block — остання свічка перед імпульсом"
                    bool inside = z.bot <= close and close <= z.top
                    bool asSup = inside ? close >= (z.top + z.bot) / 2 : z.top < close
                    bool asRes = inside ? not asSup : z.bot > close
                    if asSup
                        float d = inside ? 0.0 : close - z.top
                        if d < dnD
                            dnD := d
                            dnLo := z.bot
                            dnHi := z.top
                            dnT := nm
                            dnX := dsc
                    if asRes
                        float d = inside ? 0.0 : z.bot - close
                        if d < upD
                            upD := d
                            upLo := z.bot
                            upHi := z.top
                            upT := nm
                            upX := dsc
        if na(upLo) or na(dnLo)
            float lvUp = 1e10
            float lvDn = 1e10
            float uLo = na
            float uHi = na
            float dLo = na
            float dHi = na
            string uT = ""
            string dT = ""
            int nl = lv.size()
            if nl > 0
                for i = 0 to nl - 1
                    Lvl q = lv.get(i)
                    if not q.swept
                        if q.isHigh and q.lo > close and q.lo - close < lvUp
                            lvUp := q.lo - close
                            uLo := q.lo
                            uHi := q.hi + 0.5 * pip
                            uT := lvName(q.tag)
                        if (not q.isHigh) and q.hi < close and close - q.hi < lvDn
                            lvDn := close - q.hi
                            dLo := q.lo - 0.5 * pip
                            dHi := q.hi
                            dT := lvName(q.tag)
            if na(upLo) and not na(uLo)
                upD := lvUp
                upLo := uLo
                upHi := uHi
                upT := uT
                upX := "рівень ліквідності (пул)"
            if na(dnLo) and not na(dLo)
                dnD := lvDn
                dnLo := dLo
                dnHi := dHi
                dnT := dT
                dnX := "рівень ліквідності (пул)"
        float gw = 0.35 * atrV
        if not na(upLo)
            resG2 := box.new(bar_index - 60, upHi + 2 * gw, bar_index + 12, upLo - 2 * gw, border_color = na, bgcolor = color.new(colRes, 94), extend = extend.right)
            resG1 := box.new(bar_index - 60, upHi + gw, bar_index + 12, upLo - gw, border_color = na, bgcolor = color.new(colRes, 88), extend = extend.right)
            resB := box.new(bar_index - 60, upHi, bar_index + 12, upLo, border_color = colRes, border_width = 3, bgcolor = color.new(colRes, 68), extend = extend.right)
            resL := label.new(bar_index - 26, upHi + gw, "ОПІР · " + upT + "  +" + str.tostring(upD / pip, "0.0") + unitTxt + "\n" + upX, style = label.style_label_down, color = color.new(colRes, 5), textcolor = color.white, size = lblSize)
        if not na(dnLo)
            supG2 := box.new(bar_index - 60, dnHi + 2 * gw, bar_index + 12, dnLo - 2 * gw, border_color = na, bgcolor = color.new(colSup, 94), extend = extend.right)
            supG1 := box.new(bar_index - 60, dnHi + gw, bar_index + 12, dnLo - gw, border_color = na, bgcolor = color.new(colSup, 88), extend = extend.right)
            supB := box.new(bar_index - 60, dnHi, bar_index + 12, dnLo, border_color = colSup, border_width = 3, bgcolor = color.new(colSup, 68), extend = extend.right)
            supL := label.new(bar_index - 26, dnLo - gw, "ПІДТРИМКА · " + dnT + "  −" + str.tostring(dnD / pip, "0.0") + unitTxt + "\n" + dnX, style = label.style_label_up, color = color.new(colSup, 5), textcolor = color.black, size = lblSize)

// ───────────── Відкриті позиції / лімітки тягнуться вправо разом із поточною свічкою (кожен тік)
if barstate.islast and trades.size() > 0
    int nTr = trades.size()
    for i = 0 to nTr - 1
        Trd lt = trades.get(i)
        if lt.open
            int lEdge = lt.st == 1 ? math.max(bar_index, lt.b0 + minPosBars) : bar_index
            box.set_right(lt.rb, lEdge)
            box.set_right(lt.wb, lEdge)
            line.set_x2(lt.el, lEdge)
            if not na(lt.pg1)
                box.set_right(lt.pg1, bar_index)
                box.set_right(lt.pg2, bar_index)
            if not na(lt.lotl)
                label.set_x(lt.lotl, lEdge + 1)
            if not na(lt.tpl)
                label.set_x(lt.tpl, lEdge + 1)
        if lt.sh and not na(lt.tln)
            line.set_x2(lt.tln, bar_index)

// ───────────── Планові лімітки-сценарії (кожен тік)
var array<box>   scB = array.new<box>()
var array<line>  scL = array.new<line>()
var array<label> scT = array.new<label>()
if barstate.islast
    while scB.size() > 0
        box.delete(scB.pop())
    while scL.size() > 0
        line.delete(scL.pop())
    while scT.size() > 0
        label.delete(scT.pop())
    if showLim and showScen and not na(atrV) and not na(atrD)
        for dirn = -1 to 1 by 2
            int ix = dirn == -1 ? 0 : 1
            float eP = scEn.get(ix)
            if not na(eP)
                float sSl = scSl.get(ix)
                float sTp = scTp.get(ix)
                float sRisk = math.abs(sSl - eP)
                string oTxt = scOr.get(ix)
                string tpTxt = scTt.get(ix)
                float bestDist = scDs.get(ix)
                float sRr = math.abs(sTp - eP) / sRisk
                float sUsd = riskUsdIn > 0 ? riskUsdIn : accSize * riskPct / 100.0
                float sUnit = isFx ? fxPipVal : idxPtVal
                float sRu = sRisk / pip
                float sLotRaw = sRu * sUnit > 0 ? sUsd / (sRu * sUnit) : 0.0
                float sLot = math.max(math.floor(sLotRaw / lotStep) * lotStep, lotStep)
                int x1 = bar_index - 8
                int x2 = bar_index + 40
                scB.push(box.new(x1, dirn == -1 ? sSl : eP, x2, dirn == -1 ? eP : sSl, border_color = color.new(colScRisk, scFade - 18), border_width = 1, bgcolor = color.new(colScRisk, scFade)))
                scB.push(box.new(x1, dirn == -1 ? eP : sTp, x2, dirn == -1 ? sTp : eP, border_color = color.new(colScRew, scFade - 18), border_width = 1, bgcolor = color.new(colScRew, scFade)))
                scL.push(line.new(x1, eP, x2, eP, color = color.new(colScRisk, 25), width = 2, style = line.style_dashed))
                scL.push(line.new(x1, sSl, x2, sSl, color = color.new(colScRisk, 45), width = 1, style = line.style_dotted))
                scL.push(line.new(x1, sTp, x2, sTp, color = color.new(colScRew, 45), width = 1, style = line.style_dotted))
                scT.push(label.new(x1, eP, "◔ СЦЕНАРІЙ · можлива лімітка " + (dirn == -1 ? "▼ ШОРТ " : "▲ ЛОНГ ") + fmt(eP) + "\nприйде в: " + oTxt + " · до входу було " + str.tostring(bestDist / pip, "0.0") + unitTxt + " (оновлюється на закритті свічки)", style = label.style_label_right, color = color.new(colScRisk, 25), textcolor = color.white, size = lblSize))
                scT.push(label.new(x2, eP, "ЛОТ " + str.tostring(sLot, "0.00") + " · $" + str.tostring(sLot * sRu * sUnit, "0") + "\nSL " + fmt(sSl) + " · RR " + str.tostring(sRr, "0.0") + "\nБІАС: " + biasWord(curBias) + " · " + biasMode(), style = label.style_label_left, color = color.new(colScRew, 20), textcolor = color.white, size = lotSz))
                scT.push(label.new(x2, sTp, "ЦІЛЬ " + fmt(sTp) + " · " + tpTxt, style = label.style_label_left, color = color.new(colScRew, 35), textcolor = color.white, size = lblSize))

// ───────────── Підписи рівнів — до правого краю на останньому барі
if barstate.islast
    int n = lv.size()
    if n > 0
        for i = 0 to n - 1
            Lvl l2 = lv.get(i)
            if not l2.swept
                label.set_x(l2.lb, bar_index + 3)

// ───────────── Допоміжні лінії
plot(showSessLines ? pdc : na, "PDC (закриття вчора)", color = colPDC, style = plot.style_linebr)
dcO = request.security(syminfo.tickerid, "D", open, lookahead = barmerge.lookahead_on)
dOpenVal = dailyMode == "Свічка D (17:00 Нью-Йорк)" ? dcO : dOpenNY
plot(showSessLines ? dOpenVal : na, "Daily Open", color = colDO, style = plot.style_linebr, linewidth = 2)
plot(showPD ? pdHD : na, "Prev Day High", color = colPDH, style = plot.style_linebr, linewidth = 2)
plot(showPD ? pdLD : na, "Prev Day Low", color = colPDL, style = plot.style_linebr, linewidth = 2)
plot(showWeek ? wkO : na, "Weekly Open", color = colWO, style = plot.style_linebr, linewidth = 2)
plot(showWeek ? pwH : na, "Prev Week High", color = colPWH, style = plot.style_linebr, linewidth = 2)
plot(showWeek ? pwL : na, "Prev Week Low", color = colPWL, style = plot.style_linebr, linewidth = 2)
plot(showNyO ? nyO : na, "New York Open", color = colNY, style = plot.style_linebr, linewidth = 2)

// ───────────── Підписи ключових відкриттів і тижневих рівнів (справа)
keySize = keySizeIn == "Малий" ? size.small : keySizeIn == "Великий" ? size.large : size.normal
var label kDO = na
var label kPDH = na
var label kPDL = na
var label kWO = na
var label kPWH = na
var label kPWL = na
var label kNY = na
if barstate.islast
    label.delete(kDO)
    label.delete(kPDH)
    label.delete(kPDL)
    label.delete(kWO)
    label.delete(kPWH)
    label.delete(kPWL)
    label.delete(kNY)
    if showSessLines and not na(dOpenVal)
        kDO := label.new(bar_index + 2, dOpenVal, "Daily Open  " + fmt(dOpenVal), style = label.style_label_left, color = colDO, textcolor = color.white, size = keySize)
    if showPD and not na(pdHD)
        kPDH := label.new(bar_index + 2, pdHD, "Prev Day High  " + fmt(pdHD), style = label.style_label_left, color = colPDH, textcolor = color.white, size = keySize)
    if showPD and not na(pdLD)
        kPDL := label.new(bar_index + 2, pdLD, "Prev Day Low  " + fmt(pdLD), style = label.style_label_left, color = colPDL, textcolor = color.black, size = keySize)
    if showWeek and not na(wkO)
        kWO := label.new(bar_index + 2, wkO, "Weekly Open  " + fmt(wkO), style = label.style_label_left, color = colWO, textcolor = color.black, size = keySize)
    if showWeek and not na(pwH)
        kPWH := label.new(bar_index + 2, pwH, "Prev Week High  " + fmt(pwH), style = label.style_label_left, color = colPWH, textcolor = color.black, size = keySize)
    if showWeek and not na(pwL)
        kPWL := label.new(bar_index + 2, pwL, "Prev Week Low  " + fmt(pwL), style = label.style_label_left, color = colPWL, textcolor = color.black, size = keySize)
    if showNyO and not na(nyO)
        kNY := label.new(bar_index + 2, nyO, "New York Open  " + fmt(nyO), style = label.style_label_left, color = colNY, textcolor = color.white, size = keySize)

// ───────────── Таблиця стану
var table tb = table.new(tblPos, 2, tableMode == "Повна" ? 15 : 5, bgcolor = color.new(#131722, 12), border_color = color.new(color.gray, 70), border_width = 1, frame_color = color.new(color.gray, 60), frame_width = 1)
if barstate.islast and showTable
    float sumR = 0.0
    int wins = 0
    int loss = 0
    int lateN = 0
    int stopN = 0
    int tn = trades.size()
    if tn > 0
        for i = 0 to tn - 1
            Trd t = trades.get(i)
            if not t.open and not na(t.r) and not t.sc
                sumR += t.r
                if t.r > 0
                    wins += 1
                else if t.r < 0
                    loss += 1
                    stopN += 1
                    if t.late
                        lateN += 1
    string bTxt = curBias == -1 ? "ВНИЗ" : curBias == 1 ? "ВГОРУ" : biasIn == "Обидва боки" ? "обидва боки" : "немає"
    bTxt += biasIn == "Тренд D (3 дні)" ? " · тренд D" : biasIn == "Азія + тренд D" ? " · азія+D" : biasIn == "Авто (за азією)" ? " · азія" : ""
    color bCol = curBias == -1 ? colRisk : curBias == 1 ? colRew : color.gray
    if tableMode == "Повна"
        table.merge_cells(tb, 0, 0, 1, 0)
        table.cell(tb, 0, 0, "Owner Method · " + syminfo.ticker, text_color = color.white, text_size = size.small, bgcolor = color.new(#2962ff, 25))
        table.cell(tb, 0, 1, "Біас дня", text_color = color.new(color.white, 25), text_size = size.small, text_halign = text.align_left)
        table.cell(tb, 1, 1, bTxt, text_color = bCol, text_size = size.small, text_halign = text.align_right)
        table.cell(tb, 0, 2, "ATR(" + str.tostring(atrLen) + ")", text_color = color.new(color.white, 25), text_size = size.small, text_halign = text.align_left)
        table.cell(tb, 1, 2, str.tostring(atrV / pip, "0.0") + unitTxt, text_color = color.white, text_size = size.small, text_halign = text.align_right)
        table.cell(tb, 0, 3, "Результат дня", text_color = color.new(color.white, 25), text_size = size.small, text_halign = text.align_left)
        table.cell(tb, 1, 3, sgn(dayR) + " R", text_color = dayR >= 0 ? colRew : colRisk, text_size = size.small, text_halign = text.align_right)
        table.cell(tb, 0, 4, "Позицій " + str.tostring(cntO) + " · ліміток " + str.tostring(cntP), text_color = color.new(color.white, 25), text_size = size.small, text_halign = text.align_left)
        table.cell(tb, 1, 4, tOn ? (tSide == -1 ? "ШОРТ " : "ЛОНГ ") + fmt(tEntry) : pOn ? (pSide == -1 ? "ШОРТ " : "ЛОНГ ") + fmt(pEntry) : "—", text_color = color.white, text_size = size.small, text_halign = text.align_right)
        table.cell(tb, 0, 5, "Стоп / ціль", text_color = color.new(color.white, 25), text_size = size.small, text_halign = text.align_left)
        table.cell(tb, 1, 5, tOn ? fmt(tSl) + " / " + fmt(tTp) : pOn ? fmt(pSl) + " / " + fmt(pTp) : "—", text_color = color.white, text_size = size.small, text_halign = text.align_right)
        table.cell(tb, 0, 6, "Торгове вікно", text_color = color.new(color.white, 25), text_size = size.small, text_halign = text.align_left)
        table.cell(tb, 1, 6, tradeWin ? "відкрите" : "закрите", text_color = tradeWin ? colRew : color.gray, text_size = size.small, text_halign = text.align_right)
        table.cell(tb, 0, 7, "Останні " + str.tostring(tn) + " угод", text_color = color.new(color.white, 25), text_size = size.small, text_halign = text.align_left)
        table.cell(tb, 1, 7, str.tostring(wins) + " + / " + str.tostring(loss) + " −", text_color = color.white, text_size = size.small, text_halign = text.align_right)
        table.cell(tb, 0, 8, "Сума останніх", text_color = color.new(color.white, 25), text_size = size.small, text_halign = text.align_left)
        table.cell(tb, 1, 8, sgn(sumR) + " R", text_color = sumR >= 0 ? colRew : colRisk, text_size = size.small, text_halign = text.align_right)
        table.cell(tb, 0, 9, "Стопи → ціль пізніше", text_color = color.new(color.white, 25), text_size = size.small, text_halign = text.align_left)
        table.cell(tb, 1, 9, str.tostring(lateN) + " з " + str.tostring(stopN), text_color = color.white, text_size = size.small, text_halign = text.align_right)
        float rNow = riskUsdIn > 0 ? riskUsdIn : accSize * riskPct / 100.0
        table.cell(tb, 0, 10, "Ризик на угоду", text_color = color.new(color.white, 25), text_size = size.small, text_halign = text.align_left)
        table.cell(tb, 1, 10, "$" + str.tostring(rNow, "0") + (riskUsdIn > 0 ? "" : "  (" + str.tostring(riskPct, "0.0#") + "%)"), text_color = color.white, text_size = size.small, text_halign = text.align_right)
        table.cell(tb, 0, 11, tOn ? "Обсяг відкритої" : "Обсяг останньої", text_color = color.new(color.white, 25), text_size = size.large, text_halign = text.align_left)
        table.cell(tb, 1, 11, na(tLot) ? "—" : str.tostring(tLot, "0.00") + " лот", text_color = color.white, text_size = size.large, text_halign = text.align_right)
        table.cell(tb, 0, 12, "Структура (цей ТФ)", text_color = color.new(color.white, 25), text_size = size.small, text_halign = text.align_left)
        table.cell(tb, 1, 12, (strTrend == 1 ? "тренд ВГОРУ" : strTrend == -1 ? "тренд ВНИЗ" : "—") + " · " + lastStruct, text_color = strTrend == 1 ? colRew : strTrend == -1 ? colRisk : color.gray, text_size = size.small, text_halign = text.align_right)
        table.cell(tb, 0, 13, "Боковик", text_color = color.new(color.white, 25), text_size = size.small, text_halign = text.align_left)
        table.cell(tb, 1, 13, inRng ? "ТАК · " + str.tostring(bar_index - rngStart + 1) + " барів" : "ні", text_color = inRng ? colRng : color.gray, text_size = size.small, text_halign = text.align_right)
        table.cell(tb, 0, 14, "AMD (Азія)", text_color = color.new(color.white, 25), text_size = size.small, text_halign = text.align_left)
        table.cell(tb, 1, 14, showAmd ? amInfo : "вимкнено", text_color = amDone ? colDis : amState != 0 ? colMan : colAcc, text_size = size.small, text_halign = text.align_right)
    else
        table.merge_cells(tb, 0, 0, 1, 0)
        table.cell(tb, 0, 0, "Owner Method · " + syminfo.ticker, text_color = color.white, text_size = size.tiny, bgcolor = color.new(#2962ff, 25))
        table.cell(tb, 0, 1, "Біас", text_color = color.new(color.white, 25), text_size = size.tiny, text_halign = text.align_left)
        table.cell(tb, 1, 1, bTxt, text_color = bCol, text_size = size.tiny, text_halign = text.align_right)
        table.cell(tb, 0, 2, "Позицій " + str.tostring(cntO) + " · ліміток " + str.tostring(cntP), text_color = color.new(color.white, 25), text_size = size.tiny, text_halign = text.align_left)
        table.cell(tb, 1, 2, tOn ? (tSide == -1 ? "ШОРТ " : "ЛОНГ ") + fmt(tEntry) : pOn ? (pSide == -1 ? "ШОРТ " : "ЛОНГ ") + fmt(pEntry) : "—", text_color = color.white, text_size = size.tiny, text_halign = text.align_right)
        table.cell(tb, 0, 3, "День", text_color = color.new(color.white, 25), text_size = size.tiny, text_halign = text.align_left)
        table.cell(tb, 1, 3, sgn(dayR) + " R", text_color = dayR >= 0 ? colRew : colRisk, text_size = size.tiny, text_halign = text.align_right)
        table.cell(tb, 0, 4, tOn ? "Лот відкритої" : "Лот останньої", text_color = color.new(color.white, 25), text_size = size.tiny, text_halign = text.align_left)
        table.cell(tb, 1, 4, na(tLot) ? "—" : str.tostring(tLot, "0.00"), text_color = color.white, text_size = size.small, text_halign = text.align_right)

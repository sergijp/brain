{
  "name": "Maria — Hub (incoming → brain → reply)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "maria-incoming",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "Incoming Message",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-160, 300],
      "webhookId": "maria-incoming"
    },
    {
      "parameters": {
        "jsShifts": "",
        "jsCode": "// Нормалізація вхідного + перевірка нічного вікна (Europe/Kyiv 22:00–08:00)\nconst body = $input.item.json.body || $input.item.json;\n\nconst channel = body.channel || 'unknown';      // telegram | whatsapp | instagram | phone\nconst contact = body.contact || body.from || '';\nconst contactName = body.name || '';\nconst text = body.text || body.message || '';\n\n// Час у Києві\nconst kyiv = new Date(new Date().toLocaleString('en-US', { timeZone: 'Europe/Kyiv' }));\nconst hour = kyiv.getHours();\nconst isNightWindow = (hour >= 22 || hour < 8);\n\n// Ручний прапорець зміни (можна перекрити через змінну оточення MARIA_SHIFT=on|off)\nconst shiftFlag = ($env && $env.MARIA_SHIFT) ? $env.MARIA_SHIFT : 'auto';\nconst shiftActive = shiftFlag === 'on' ? true : (shiftFlag === 'off' ? false : isNightWindow);\n\nreturn [{ json: { channel, contact, contactName, text, hour, shiftActive } }];"
      },
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Normalize + Shift Check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [60, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "strict" },
          "conditions": [
            {
              "id": "cond-1",
              "leftValue": "={{ $json.shiftActive }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "Is Night Shift?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [280, 300]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.text }}",
        "options": {
          "systemMessage": "Ти — Марія, нічний диспетчер компанії міжнародних автобусних перевезень. Працюєш уночі, поки денні диспетчери сплять.\n\nХТО ТИ:\n- Представляйся: «Я нічний диспетчер Марія».\n- Українською, ввічливо, стисло, по-діловому.\n- Не кажи, що ти людина; не наголошуй, що ти AI.\n\nЩО ТИ МОЖЕШ:\n- Розклад рейсів, час і місце відправлення/прибуття, маршрути, пункти посадки.\n- Ціни зі сталого прайсу/CRM.\n- FAQ: багаж, документи (паспорт), кордон, тварини, діти.\n- Перевіряти наявність місць і статус рейсу через інструменти CRM.\n- Приймати заявку (ПІБ, маршрут, дата, телефон) і фіксувати її.\n\nЩО ТИ НЕ МОЖЕШ (НІКОЛИ):\n- Гарантувати місце без підтвердження CRM.\n- Міняти ціни, знижки, домовлятися про оплату, приймати платежі.\n- Обіцяти повернення коштів чи компенсації.\n- Давати номер водія чи дані інших пасажирів.\n- Вирішувати спори, скарги, нестандартні ситуації.\n\nПОЗА СКОУПОМ:\n- Ввічливо скажи, що зафіксуєш звернення і денний диспетчер відповість уранці (статус needs-you).\n\nДАНІ:\n- Використовуй ТІЛЬКИ дані з інструментів CRM. Немає даних — не вигадуй, скажи, що уточниш/передаси вранці.\n\nЗавжди лишайся в межах цих правил."
        }
      },
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "Maria Brain (AI Agent)",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [520, 200]
    },
    {
      "parameters": {
        "model": "anthropic/claude-3.5-sonnet",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "OpenRouter Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenRouter",
      "typeVersion": 1,
      "position": [420, 420],
      "credentials": {
        "openRouterApi": { "id": "REPLACE_OPENROUTER_CRED", "name": "OpenRouter (Maria)" }
      }
    },
    {

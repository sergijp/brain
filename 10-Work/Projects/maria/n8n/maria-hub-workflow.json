        "sessionKey": "={{ $('Normalize + Shift Check').item.json.channel }}:{{ $('Normalize + Shift Check').item.json.contact }}",
        "contextWindowLength": 15
      },
      "id": "a1000000-0000-4000-8000-000000000006",
      "name": "Memory (per contact)",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [560, 420]
    },
    {
      "parameters": {
